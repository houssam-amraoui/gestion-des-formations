{
  "Application": {
    "Name": "Training Management",
    "PublicBaseUrl": "http://localhost:5012"
  },
  "CertificateStorage": {
    "BasePath": "App_Data/Certificates"
  },
  "AiTrainer": {
    "Enabled": true,
    "Provider": "Mock",
    "LanguageModelProvider": "Mock",
    "AvatarProvider": "Mock",
    "SpeechToTextProvider": "Mock",
    "TextToSpeechProvider": "Mock",
    "DefaultLanguage": "fr-FR",

@model TrainingManagement.Web.ViewModels.Trainings.TrainingDetailsViewModel
@{var item=Model.Training;ViewData["Title"]=item.Title;var returnUrl=$"/Trainings/{item.Slug}";}
<section class="training-detail-hero"><div class="container py-5"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="badge text-bg-primary-subtle text-primary mb-3">@item.CategoryName</span><h1 class="display-5 fw-bold">@item.Title</h1><p class="lead text-secondary">@item.ShortDescription</p><div class="d-flex flex-wrap gap-3 text-secondary"><span>@item.Level.ToFrenchLabel()</span><span>@item.EstimatedDurationHours heures</span><span>@item.Language</span></div></div><div class="col-lg-5">@if(!string.IsNullOrWhiteSpace(item.ThumbnailUrl)){<img class="img-fluid rounded-4 shadow" src="@item.ThumbnailUrl" alt="@item.Title"/>}else{<div class="detail-placeholder">TrainingManagement</div>}</div></div></div></section>
<div class="container py-5"><div class="row g-5"><article class="col-lg-8"><h2 class="h3 fw-bold">À propos de cette formation</h2><div class="preserve-lines text-secondary">@item.Description</div><hr class="my-5"/><h2 class="h3 fw-bold">Programme</h2>@if(Model.Curriculum.Modules.Count==0){<p class="text-secondary">Le programme détaillé sera bientôt disponible.</p>}else{<div class="accordion curriculum" id="curriculum">@foreach(var module in Model.Curriculum.Modules){<div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#module-@module.Id"><span class="me-2">@module.Order.</span>@module.Title <span class="badge text-bg-light ms-auto me-3">@module.Lessons.Count leçon(s)</span></button></h3><div id="module-@module.Id" class="accordion-collapse collapse"><div class="accordion-body">@foreach(var lesson in module.Lessons){<a class="curriculum-lesson" asp-controller="Lessons" asp-action="Details" asp-route-trainingSlug="@item.Slug" asp-route-moduleSlug="@module.Slug" asp-route-lessonSlug="@lesson.Slug"><span>@lesson.Order. @lesson.Title @if(lesson.IsPreview){<span class="badge text-bg-info">Aperçu gratuit</span>}</span><small>@lesson.EstimatedDurationMinutes min</small></a>}</div></div></div>}</div>}</article>
<aside class="col-lg-4"><div class="card border-0 shadow-sm sticky-lg-top detail-enroll-card"><div class="card-body p-4"><div class="h3 fw-bold text-primary mb-3">@(item.IsFree?"Gratuit":$"{item.Price:N2} MAD")</div><dl><dt>Formateur</dt><dd>@(item.TrainerName??"À confirmer")</dd><dt>Catégorie</dt><dd>@item.CategoryName</dd><dt>Durée</dt><dd>@item.EstimatedDurationHours heures</dd></dl>@if(Model.HasEnrollmentAccess){<a class="btn btn-success w-100" asp-area="Learner" asp-controller="Trainings" asp-action="Details" asp-route-id="@item.Id">Continuer ma formation</a>}else if(item.IsFree&&User.Identity?.IsAuthenticated==true){<form asp-controller="Trainings" asp-action="Enroll" asp-route-id="@item.Id" method="post"><button class="btn btn-primary w-100">S’inscrire gratuitement</button></form>}else if(item.IsFree){<a class="btn btn-primary w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">S’inscrire gratuitement</a>}else{<div class="alert alert-info">Cette formation nécessite une validation d’inscription par l’administration.</div>}</div></div></aside></div></div>

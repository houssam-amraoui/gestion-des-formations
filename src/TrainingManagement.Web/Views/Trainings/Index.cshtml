@model TrainingManagement.Web.ViewModels.Trainings.PublicTrainingListViewModel
@{ ViewData["Title"]="Formations"; }
<section class="catalog-hero"><div class="container py-5 text-center"><span class="badge text-bg-primary-subtle text-primary mb-3">Catalogue</span><h1 class="display-5 fw-bold">Trouvez la formation qui vous fera avancer</h1><p class="lead text-secondary">Des parcours pratiques, animés par des formateurs experts.</p></div></section>
<div class="container py-5"><form method="get" class="card card-body border-0 shadow-sm mb-5"><div class="row g-2"><div class="col-lg-5"><input class="form-control" asp-for="Search" name="search" placeholder="Rechercher une formation…" /></div><div class="col-lg-3"><select class="form-select" asp-for="CategoryId" name="categoryId" asp-items="Model.Categories"><option value="">Toutes les catégories</option></select></div><div class="col-lg-2"><select class="form-select" asp-for="Level" name="level"><option value="">Tous niveaux</option>@foreach(var level in Enum.GetValues<TrainingLevel>()){<option value="@level">@level.ToFrenchLabel()</option>}</select></div><div class="col-lg-2"><button class="btn btn-primary w-100">Rechercher</button></div></div></form>
<div class="d-flex justify-content-between align-items-end mb-4"><div><h2 class="h3 fw-bold mb-1">Formations publiées</h2><p class="text-secondary mb-0">@Model.Results.TotalCount résultat(s)</p></div></div>
@if(Model.Results.Items.Count==0){<div class="empty-state"><h3 class="h5">Aucune formation trouvée</h3><p class="text-secondary">Essayez de modifier vos critères de recherche.</p><a class="btn btn-outline-primary" asp-action="Index">Effacer les filtres</a></div>}
else{<div class="row g-4">@foreach(var item in Model.Results.Items){<div class="col-md-6 col-xl-4"><partial name="_TrainingCard" model="item" /></div>}</div>}
@if(Model.Results.TotalPages>1){<nav class="mt-5"><ul class="pagination justify-content-center">@for(var p=1;p<=Model.Results.TotalPages;p++){<li class="page-item @(p==Model.Results.Page?"active":"")"><a class="page-link" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-level="@Model.Level">@p</a></li>}</ul></nav>}</div>

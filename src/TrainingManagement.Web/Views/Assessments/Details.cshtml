@model TrainingManagement.Web.ViewModels.Assessments.PublicAssessmentViewModel
@{var a=Model.Assessment;ViewData["Title"]=a.Title;}
<div class="container py-5">
<nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-slug="@a.TrainingSlug">@a.TrainingTitle</a></li><li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-trainingSlug="@a.TrainingSlug" asp-route-moduleSlug="@a.ModuleSlug" asp-route-lessonSlug="@a.LessonSlug">@a.LessonTitle</a></li><li class="breadcrumb-item active">@a.Title</li></ol></nav>
<h1 class="display-6 fw-bold">@a.Title</h1><p class="lead">@a.Description</p><div class="d-flex flex-wrap gap-2 mb-4"><span class="badge text-bg-info">@a.AssessmentType.ToFrenchLabel()</span><span class="badge text-bg-light">@a.PassingScore % requis</span><span class="badge text-bg-light">@(a.TimeLimitMinutes is null?"Sans limite":$"{a.TimeLimitMinutes} minutes")</span></div>
@foreach(var q in a.Questions){<section class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@q.Order. @q.Statement</h2><span class="badge text-bg-primary">@q.Points point(s)</span></div><span class="badge text-bg-secondary">@q.QuestionType.ToFrenchLabel()</span>@if(q.QuestionType==QuestionType.ShortAnswer){<input class="form-control mt-3" disabled placeholder="Réponse courte — mode aperçu"/>}else{<div class="list-group mt-3">@foreach(var o in q.Options){<label class="list-group-item"><input class="form-check-input me-2" type="@(q.QuestionType==QuestionType.MultipleChoice?"checkbox":"radio")" disabled/>@o.Text</label>}</div>}</div></section>}
<div class="alert alert-info mt-4">Le mode interactif et l’enregistrement des résultats seront ajoutés lors de l’étape des inscriptions et de la progression.</div></div>

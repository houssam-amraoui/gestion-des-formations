@model TrainingManagement.Web.ViewModels.Attempts.AttemptResultViewModel
@{var r=Model.Result;ViewData["Title"]="Résultat — "+r.AssessmentTitle;}<div class="container py-5"><div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><span class="badge @(r.Passed?"text-bg-success":"text-bg-danger")">@(r.Passed?"Réussi":"Échoué")</span><h1 class="h2 fw-bold mt-2">@r.AssessmentTitle</h1><p>@r.TrainingTitle · Tentative @r.AttemptNumber · @r.Status.ToFrenchLabel()</p><div class="row text-center g-3"><div class="col-md-3"><div class="h3">@r.Score / @r.MaximumScore</div><small>Score</small></div><div class="col-md-3"><div class="h3">@r.PercentageScore.ToString("N2") %</div><small>Pourcentage</small></div><div class="col-md-3"><div class="h3">@r.PassingScore %</div><small>Seuil</small></div><div class="col-md-3"><div class="h3">@TimeSpan.FromSeconds(r.DurationSeconds).ToString(@"mm\:ss")</div><small>Durée</small></div></div></div></div>
@foreach(var q in r.Questions){<section class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@q.Statement</h2><span class="badge @(q.IsCorrect?"text-bg-success":"text-bg-danger")">@q.PointsAwarded / @q.Points</span></div><p><strong>Votre réponse :</strong> @q.LearnerAnswer</p>@if(r.ShowCorrectAnswers){<p class="text-success"><strong>Bonne réponse :</strong> @q.CorrectAnswer</p>@if(!string.IsNullOrWhiteSpace(q.Explanation)){<p><strong>Explication :</strong> @q.Explanation</p>}}else{<p>@(q.IsCorrect?"Réponse correcte":"Réponse incorrecte")</p>}</div></section>}</div>

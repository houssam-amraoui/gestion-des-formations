@model TrainingManagement.Web.ViewModels.Lessons.LessonPageViewModel
@{var l=Model.Lesson;}
<div class="container py-5 lesson-page">
<nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-area="" asp-controller="Trainings" asp-action="Details" asp-route-slug="@l.TrainingSlug">@l.TrainingTitle</a></li><li class="breadcrumb-item">@l.ModuleTitle</li><li class="breadcrumb-item active">@l.Title</li></ol></nav>
<div class="row g-5"><main class="col-lg-8">
<div class="d-flex flex-wrap gap-2 mb-3">@if(l.IsPreview){<span class="badge text-bg-info">Aperçu gratuit</span>}<span class="badge text-bg-light">@l.EstimatedDurationMinutes minutes</span></div>
<h1 class="display-6 fw-bold">@l.Title</h1><p class="lead text-secondary">@l.Summary</p><hr class="my-4"/>
@if(l.ContentAccessible){
    @if(l.Contents.Count==0){<div class="alert alert-warning">Cette leçon ne contient encore aucun bloc.</div>}
    @foreach(var content in l.Contents){<partial name="/Views/Shared/LessonContents/_LessonContent.cshtml" model="content" />}
}else{
    <div class="locked-lesson"><div class="display-5">🔒</div><h2 class="h4">Contenu réservé</h2><p>Cette leçon est réservée aux apprenants inscrits. Le système d’inscription sera ajouté prochainement.</p></div>
}
@if(l.ContentAccessible){
<section class="mt-5"><h2 class="h3">Évaluations disponibles</h2>
@if(Model.Assessments.Count==0){<div class="empty-state">Aucune évaluation publiée pour cette leçon.</div>}
else{<div class="row g-3">@foreach(var a in Model.Assessments){<div class="col-md-6"><article class="card h-100 border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-info">@a.AssessmentType.ToFrenchLabel()</span><h3 class="h5 mt-3">@a.Title</h3><p>@a.Description</p><div class="small text-secondary mb-3">@a.QuestionCount question(s) · @(a.TimeLimitMinutes is null?"Sans limite":$"{a.TimeLimitMinutes} min") · Seuil @a.PassingScore %</div><a class="btn btn-outline-primary" asp-area="" asp-controller="Assessments" asp-action="Details" asp-route-trainingSlug="@l.TrainingSlug" asp-route-moduleSlug="@l.ModuleSlug" asp-route-lessonSlug="@l.LessonSlug" asp-route-assessmentSlug="@a.Slug">Aperçu du quiz</a></div></article></div>}</div>}
</section>}
</main>
<aside class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Navigation</h2>@if(l.Previous is not null){<a class="lesson-nav-link" asp-area="" asp-controller="Lessons" asp-action="Details" asp-route-trainingSlug="@l.Previous.TrainingSlug" asp-route-moduleSlug="@l.Previous.ModuleSlug" asp-route-lessonSlug="@l.Previous.LessonSlug">← @l.Previous.Title</a>}@if(l.Next is not null){<a class="lesson-nav-link text-end" asp-area="" asp-controller="Lessons" asp-action="Details" asp-route-trainingSlug="@l.Next.TrainingSlug" asp-route-moduleSlug="@l.Next.ModuleSlug" asp-route-lessonSlug="@l.Next.LessonSlug">@l.Next.Title →</a>}</div></div></aside>
</div></div>

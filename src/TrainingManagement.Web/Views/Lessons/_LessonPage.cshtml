@model TrainingManagement.Web.ViewModels.Lessons.LessonPageViewModel
@{var l=Model.Lesson;}
<div class="container py-5 lesson-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-area="" asp-controller="Trainings" asp-action="Details" asp-route-slug="@l.TrainingSlug">@l.TrainingTitle</a></li><li class="breadcrumb-item">@l.ModuleTitle</li><li class="breadcrumb-item active">@l.Title</li></ol></nav><div class="row g-5"><main class="col-lg-8"><div class="d-flex flex-wrap gap-2 mb-3">@if(l.IsPreview){<span class="badge text-bg-info">Aperçu gratuit</span>}<span class="badge text-bg-light">@l.EstimatedDurationMinutes minutes</span></div><h1 class="display-6 fw-bold">@l.Title</h1><p class="lead text-secondary">@l.Summary</p><hr class="my-4"/>
@if(l.ContentAccessible){@if(l.Contents.Count==0){<div class="alert alert-warning">Cette leçon ne contient encore aucun bloc.</div>}@foreach(var content in l.Contents){<partial name="/Views/Shared/LessonContents/_LessonContent.cshtml" model="content" />}}
else{<div class="locked-lesson"><div class="display-5">🔒</div><h2 class="h4">Contenu réservé</h2><p>Cette leçon est réservée aux apprenants inscrits. Le système d’inscription sera ajouté prochainement.</p></div>}</main>
<aside class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Navigation</h2>@if(l.Previous is not null){<a class="lesson-nav-link" asp-area="" asp-controller="Lessons" asp-action="Details" asp-route-trainingSlug="@l.Previous.TrainingSlug" asp-route-moduleSlug="@l.Previous.ModuleSlug" asp-route-lessonSlug="@l.Previous.LessonSlug">← @l.Previous.Title</a>}@if(l.Next is not null){<a class="lesson-nav-link text-end" asp-area="" asp-controller="Lessons" asp-action="Details" asp-route-trainingSlug="@l.Next.TrainingSlug" asp-route-moduleSlug="@l.Next.ModuleSlug" asp-route-lessonSlug="@l.Next.LessonSlug">@l.Next.Title →</a>}</div></div></aside></div></div>

{
  "Application": {
    "Name": "Training Management",
    "PublicBaseUrl": "https://example.invalid"
  },
  "CertificateStorage": {
    "BasePath": "App_Data/Certificates"
  },
  "AiTrainer": {
    "Enabled": false,
    "Provider": "Anam",
    "LanguageModelProvider": "External",
    "AvatarProvider": "Anam",
    "SpeechToTextProvider": "External",
    "TextToSpeechProvider": "External",
    "DefaultLanguage": "fr-FR",
    "MaximumQuestionLength": 2000,
    "MaximumMessagesPerSession": 20,
    "MaximumSessionDurationMinutes": 30,
    "MaximumSessionsPerUserPerDay": 10,
    "MaximumContextCharacters": 12000,
    "MaximumAudioBytes": 5000000,
    "MaximumAudioSeconds": 120,
    "ConversationRetentionDays": 365,
    "RequestTimeoutSeconds": 30,
    "ConsentPolicyVersion": "2026-01",
    "EnableAudioInput": true,
    "EnableAudioOutput": false,
    "EnableAvatar": true,
    "SaveConversationHistory": true,
    "AllowPublicPreview": false
  },
  "Anam": {
    "BaseAddress": "https://api.anam.ai/v1/"
  },
  "HeyGen": {},
  "LanguageModel": {},
  "SpeechToText": {},
  "TextToSpeech": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

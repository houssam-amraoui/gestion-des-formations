@model TrainingManagement.Application.Enrollments.LearnerDashboardModel
@{ViewData["Title"]="Espace apprenant";var analytics=(LearnerDashboardAnalytics)ViewBag.Analytics;}
<div class="container py-5"><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><span class="badge text-bg-info">Apprenant</span><h1 class="h2 fw-bold mt-2">Mon apprentissage</h1></div><div><a class="btn btn-primary" asp-controller="Trainings">Mes formations</a> <a class="btn btn-outline-primary" asp-controller="Certificates">Mes certificats</a> <a class="btn btn-outline-primary" asp-controller="Statistics">Mes statistiques</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card card-body"><small>Progression globale</small><strong class="h3">@analytics.GlobalProgress.ToString("N1")%</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Formations terminées</small><strong class="h3">@analytics.CompletedTrainings</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Réussite quiz</small><strong class="h3">@analytics.SuccessRate.ToString("N1")%</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Certificats</small><strong class="h3">@analytics.Certificates</strong></div></div></div><p class="text-secondary">Temps d’apprentissage estimé : @(analytics.EstimatedLearningSeconds/3600) h @((analytics.EstimatedLearningSeconds%3600)/60) min</p>
<div class="row g-4"><div class="col-lg-7"><h2 class="h4">Continuer</h2>@if(Model.RecentTrainings.Count==0){<div class="empty-state">Aucune formation inscrite.</div>}@foreach(var x in Model.RecentTrainings){<div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><strong>@x.Title</strong><span>@x.ProgressPercentage.ToString("N0")%</span></div><div class="progress my-3"><div class="progress-bar" style="width:@x.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div><a class="btn btn-sm btn-primary" asp-controller="Trainings" asp-action="Details" asp-route-id="@x.TrainingId">Continuer</a>@if(x.Status==EnrollmentStatus.Completed){<span class="badge text-bg-success ms-2">Formation terminée</span>}</div></div>}</div><div class="col-lg-5"><h2 class="h4">Activité récente</h2>@foreach(var a in analytics.RecentActivities){<div class="border-bottom py-2"><strong>@a.Description</strong><br/><small>@a.Type · @a.OccurredAt.ToLocalTime().ToString("g")</small></div>}</div></div></div>

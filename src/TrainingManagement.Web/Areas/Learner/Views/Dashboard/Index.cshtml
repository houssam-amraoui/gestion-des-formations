@model TrainingManagement.Application.Enrollments.LearnerDashboardModel
@{ViewData["Title"]="Espace apprenant";}<div class="container dashboard-page"><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><span class="badge text-bg-info">Apprenant</span><h1 class="h2 fw-bold mt-2">Mon apprentissage</h1></div><div><a class="btn btn-primary" asp-controller="Trainings" asp-action="Index">Mes formations</a> <a class="btn btn-outline-primary" asp-controller="Attempts" asp-action="History">Mes résultats</a></div></div>
<div class="row g-3 mb-5"><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="display-6 fw-bold">@Model.ActiveTrainings</div><span>formations actives</span></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="display-6 fw-bold">@Model.CompletedTrainings</div><span>formations terminées</span></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="display-6 fw-bold">@Model.AverageProgress.ToString("N2") %</div><span>progression moyenne</span></div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><h2 class="h4">Continuer</h2>@if(Model.RecentTrainings.Count==0){<div class="empty-state">Aucune formation inscrite.</div>}@foreach(var x in Model.RecentTrainings){<div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><strong>@x.Title</strong><span>@x.ProgressPercentage.ToString("N0") %</span></div><div class="progress my-3"><div class="progress-bar" style="width:@x.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div><a class="btn btn-sm btn-primary" asp-controller="Trainings" asp-action="Details" asp-route-id="@x.TrainingId">Continuer</a></div></div>}</div><div class="col-lg-5"><h2 class="h4">Activité récente</h2>@foreach(var l in Model.RecentLessons){<div class="border-bottom py-2"><strong>@l.LessonTitle</strong><br/><small>@l.TrainingTitle · @l.AccessedAt?.ToLocalTime().ToString("g")</small></div>}@foreach(var a in Model.RecentAttempts){<div class="border-bottom py-2"><strong>@a.AssessmentTitle</strong><br/><small>@a.PercentageScore?.ToString("N2") % · @(a.Passed==true?"Réussi":"Non réussi")</small></div>}</div></div></div>

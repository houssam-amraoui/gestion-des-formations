@model TrainingManagement.Web.ViewModels.Assessments.AssessmentDetailsViewModel
@{var a=Model.Assessment;ViewData["Title"]=a.Title;}<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@a.TrainingId">@a.TrainingTitle</a></li><li class="breadcrumb-item active">@a.Title</li></ol></nav><h1 class="display-6 fw-bold">@a.Title</h1><p class="lead">@a.Description</p><div class="d-flex flex-wrap gap-2 mb-4"><span class="badge text-bg-info">@a.AssessmentType.ToFrenchLabel()</span><span class="badge text-bg-light">@a.QuestionCount questions</span><span class="badge text-bg-light">@a.TotalPoints points</span><span class="badge text-bg-light">Seuil @a.PassingScore %</span><span class="badge text-bg-light">@(a.TimeLimitMinutes is null?"Sans limite":$"{a.TimeLimitMinutes} minutes")</span></div>@if(Model.InProgressAttemptId is not null){<a class="btn btn-primary" asp-controller="Attempts" asp-action="Details" asp-route-id="@Model.InProgressAttemptId">Reprendre la tentative</a>}else if(Model.LearnerCanStart){<form asp-action="Start" asp-route-id="@a.Id" method="post"><button class="btn btn-primary">Commencer le quiz</button></form>}else{<div class="alert alert-warning">Le nombre maximal de tentatives est atteint.</div>}@if(Model.AttemptsRemaining is not null){<p class="mt-3 text-secondary">@Model.AttemptsRemaining tentative(s) restante(s).</p>}</div>

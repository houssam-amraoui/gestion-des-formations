@model TrainingManagement.Application.Enrollments.LearnerTrainingModel
@{ViewData["Title"]=Model.Title;}<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Mes formations</a></li><li class="breadcrumb-item active">@Model.Title</li></ol></nav><div class="row align-items-center mb-5"><div class="col-lg-8"><span class="badge text-bg-info">@Model.Status.ToFrenchLabel()</span><h1 class="display-6 fw-bold mt-2">@Model.Title</h1><p>@Model.CompletedLessons leçon(s) terminée(s) sur @Model.TotalLessons</p></div><div class="col-lg-4"><div class="h3">@Model.ProgressPercentage.ToString("N2") %</div><div class="progress" style="height:22px"><div class="progress-bar" style="width:@Model.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div></div>
@foreach(var module in Model.Modules){<section class="card border-0 shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h4 mb-0">@module.Order. @module.Title</h2></div><div class="list-group list-group-flush">@foreach(var lesson in module.Lessons){<div class="list-group-item py-3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><span class="badge @(lesson.IsCompleted?"text-bg-success":lesson.ProgressStatus==LessonProgressStatus.InProgress?"text-bg-warning":"text-bg-secondary")">@lesson.ProgressStatus.ToFrenchLabel()</span><strong class="ms-2">@lesson.Order. @lesson.Title</strong><small class="text-secondary ms-2">@lesson.DurationMinutes min</small></div><a class="btn btn-sm btn-primary" asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id">@(lesson.IsCompleted?"Revoir":"Continuer")</a></div>@if(lesson.Assessments.Count>0){<div class="mt-2 ms-4">@foreach(var a in lesson.Assessments){<a class="btn btn-sm btn-outline-info me-2" asp-controller="Assessments" asp-action="Details" asp-route-id="@a.Id">@a.Title @if(a.InProgressAttemptId is not null){<span>· à reprendre</span>}</a>}</div>}</div>}</div></section>}</div>

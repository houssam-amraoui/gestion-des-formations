@model IReadOnlyCollection<TrainingManagement.Application.Enrollments.LearnerTrainingModel>
@{ViewData["Title"]="Mes formations";}<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Tableau de bord</a></li><li class="breadcrumb-item active">Mes formations</li></ol></nav><div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Mes formations</h1><a class="btn btn-outline-primary" asp-area="" asp-controller="Trainings">Explorer le catalogue</a></div>@if(Model.Count==0){<div class="empty-state">Vous n’êtes encore inscrit à aucune formation.</div>}else{<div class="row g-4">@foreach(var x in Model){<div class="col-md-6"><article class="card border-0 shadow-sm h-100">@if(!string.IsNullOrWhiteSpace(x.ThumbnailUrl)){<img src="@x.ThumbnailUrl" class="card-img-top" alt=""/>}<div class="card-body"><span class="badge text-bg-info">@x.Status.ToFrenchLabel()</span><h2 class="h4 mt-2">@x.Title</h2><div class="d-flex justify-content-between"><small>@x.CompletedLessons / @x.TotalLessons leçons</small><strong>@x.ProgressPercentage.ToString("N0") %</strong></div><div class="progress my-3"><div class="progress-bar" style="width:@x.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div><a class="btn btn-primary" asp-action="Details" asp-route-id="@x.TrainingId">Continuer</a> <a class="btn btn-outline-secondary" asp-controller="Attempts" asp-action="History" asp-route-trainingId="@x.TrainingId">Voir les résultats</a></div></article></div>}</div>}</div>

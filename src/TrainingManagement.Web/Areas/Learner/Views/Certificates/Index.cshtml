@model IReadOnlyCollection<CertificateListItem>
@{ViewData["Title"]="Mes certificats";}<div class="container py-5"><div class="d-flex justify-content-between mb-4"><div><p class="text-secondary mb-1">Espace apprenant</p><h1 class="h2 fw-bold">Mes certificats</h1></div><a class="btn btn-outline-primary" asp-controller="Statistics">Mes statistiques</a></div>
@if(Model.Count==0){<div class="alert alert-light border">Aucun certificat obtenu pour le moment.</div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Formation</th><th>Numéro</th><th>Émission</th><th>Expiration</th><th>Statut</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TrainingTitle</td><td><code>@x.CertificateNumber</code></td><td>@x.IssuedAt.ToString("dd/MM/yyyy")</td><td>@(x.ExpiresAt?.ToString("dd/MM/yyyy")??"—")</td><td>@x.Status</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Détails</a> <a class="btn btn-sm btn-primary" asp-action="Download" asp-route-id="@x.Id">Télécharger</a> <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Certificates" asp-action="Result" asp-route-verificationCode="@x.CertificateNumber">Vérifier</a></td></tr>}</tbody></table></div>}</div>

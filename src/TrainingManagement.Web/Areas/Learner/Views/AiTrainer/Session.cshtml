@model AiSessionPageViewModel
@{ ViewData["Title"] = "Formateur IA"; var session = Model.Session; }
<div class="container py-4">
    <nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-id="@session.LessonId">@session.LessonTitle</a></li><li class="breadcrumb-item active">Formateur IA</li></ol></nav>
    <div class="alert alert-warning">Le formateur IA peut produire des erreurs. Vérifiez les informations importantes dans le contenu officiel de la formation.</div>
    <div class="row g-4">
        <aside class="col-lg-4">
            <partial name="/Views/Shared/_AiAvatarPanel.cshtml" model="session"/>
            <div class="card card-body border-0 shadow-sm mt-3">
                <div><strong>Statut :</strong> @session.Status</div>
                <div><strong>Messages restants :</strong> @session.RemainingMessages</div>
                <div><strong>Temps restant :</strong> <span id="ai-time" data-seconds="@session.RemainingSeconds">@TimeSpan.FromSeconds(session.RemainingSeconds).ToString(@"hh\:mm\:ss")</span></div>
            </div>
        </aside>
        <main class="col-lg-8">
            <partial name="/Views/Shared/_AiConversationHistory.cshtml" model="session"/>
            @if (session.Status == AiConversationStatus.Active)
            {
                <form asp-action="SendMessage" method="post" class="mt-3" id="ai-message-form">
                    <input asp-for="Message.SessionId" type="hidden" />
                    <label asp-for="Message.Text" class="form-label"></label>
                    <textarea asp-for="Message.Text" class="form-control" rows="3" maxlength="2000" required></textarea>
                    <span asp-validation-for="Message.Text" class="text-danger"></span>
                    <button class="btn btn-primary mt-2" type="submit">Envoyer</button>
                    <span class="text-secondary ms-2 d-none" id="ai-loading" role="status">Le formateur réfléchit…</span>
                </form>
                @if (session.AllowAudioInput)
                {
                    <section class="card card-body mt-3">
                        <h2 class="h5">Question vocale</h2>
                        @if (Model.AudioConsent?.IsValid == true)
                        {
                            <p class="small text-secondary">Votre audio sera transmis au fournisseur @session.Provider pour transcription. Aucun fichier n’est conservé par l’application.</p>
                            <div class="d-flex gap-2"><button type="button" class="btn btn-outline-primary" id="record-audio" aria-pressed="false">🎙️ Démarrer l’enregistrement</button><span id="record-status" aria-live="polite"></span></div>
                            <form asp-action="UploadAudio" asp-route-id="@session.Id" method="post" enctype="multipart/form-data" id="audio-upload-form"><input type="file" name="audio" id="audio-file" class="d-none" accept="audio/webm,audio/wav,audio/mpeg"/></form>
                        }
                        else
                        {
                            <p>Le microphone est optionnel. Vous pouvez continuer entièrement en mode texte.</p>
                            <form asp-action="AcceptAudioConsent" method="post"><input type="hidden" name="id" value="@session.Id"/><input type="hidden" name="provider" value="@session.Provider"/><div class="form-check"><input class="form-check-input" type="checkbox" required id="audio-consent"/><label class="form-check-label" for="audio-consent">J’accepte que mon audio soit traité par le fournisseur IA configuré.</label></div><button class="btn btn-outline-primary mt-2">Accepter</button></form>
                        }
                    </section>
                }
                <form asp-action="End" asp-route-id="@session.Id" method="post" class="mt-3"><button class="btn btn-outline-danger" data-confirm="Terminer la session ?">Terminer la session</button></form>
            }
            <a class="btn btn-link mt-3" asp-action="History" asp-route-lessonId="@session.LessonId">Historique de cette leçon</a>
        </main>
    </div>
</div>
@section Scripts {
<script>
(() => {
  const form=document.getElementById('ai-message-form'); form?.addEventListener('submit',()=>document.getElementById('ai-loading')?.classList.remove('d-none'));
  const timer=document.getElementById('ai-time'); if(timer){let seconds=Number(timer.dataset.seconds);setInterval(()=>{if(seconds>0)seconds--;const h=String(Math.floor(seconds/3600)).padStart(2,'0'),m=String(Math.floor(seconds%3600/60)).padStart(2,'0'),s=String(seconds%60).padStart(2,'0');timer.textContent=`${h}:${m}:${s}`},1000)}
  const button=document.getElementById('record-audio'); if(!button)return;
  if(!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder){button.disabled=true;document.getElementById('record-status').textContent='Microphone non pris en charge par ce navigateur.';return}
  let recorder,chunks=[],timeout;
  button.addEventListener('click',async()=>{
    if(recorder?.state==='recording'){recorder.stop();return}
    try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];recorder=new MediaRecorder(stream,{mimeType:MediaRecorder.isTypeSupported('audio/webm')?'audio/webm':undefined});recorder.ondataavailable=e=>chunks.push(e.data);recorder.onstop=()=>{clearTimeout(timeout);stream.getTracks().forEach(t=>t.stop());const blob=new Blob(chunks,{type:recorder.mimeType});const file=new File([blob],'question.webm',{type:blob.type});const input=document.getElementById('audio-file');const transfer=new DataTransfer();transfer.items.add(file);input.files=transfer.files;document.getElementById('audio-upload-form').submit()};recorder.start();button.textContent='⏹️ Arrêter';button.setAttribute('aria-pressed','true');document.getElementById('record-status').textContent='Enregistrement en cours…';timeout=setTimeout(()=>recorder.state==='recording'&&recorder.stop(),120000)}
    catch{document.getElementById('record-status').textContent='Permission microphone refusée.'}
  });
})();
</script>}

@model AiSessionPageViewModel
@{
    ViewData["Title"] = "Appel avec le formateur IA";
    var session = Model.Session;
}

<div class="container py-4">
    <nav aria-label="Fil d’Ariane">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="Learner" asp-controller="Lessons" asp-action="Details"
                   asp-route-id="@session.LessonId">@session.LessonTitle</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Formateur IA</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center mb-3">
        <div>
            <p class="text-primary fw-semibold mb-1">@session.TrainingTitle</p>
            <h1 class="h2 mb-0">Session avec @session.TrainerDisplayName</h1>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <span class="badge rounded-pill text-bg-light border p-2">
                <span aria-hidden="true">💬</span> @session.RemainingMessages messages
            </span>
            <span class="badge rounded-pill text-bg-light border p-2">
                <span aria-hidden="true">⏱</span>
                <span id="ai-time" data-seconds="@session.RemainingSeconds">
                    @TimeSpan.FromSeconds(session.RemainingSeconds).ToString(@"hh\:mm\:ss")
                </span>
            </span>
        </div>
    </div>

    <div class="alert alert-warning py-2">
        Le formateur IA peut se tromper. Vérifiez les informations importantes dans le contenu officiel de la formation.
    </div>

    <div class="row g-4">
        <aside class="col-xl-7">
            <partial name="/Views/Shared/_AiAvatarPanel.cshtml" model="session" />

            @if (session.AllowAudioInput && Model.AudioConsent?.IsValid != true)
            {
                <section class="card border-0 shadow-sm mt-3">
                    <div class="card-body">
                        <h2 class="h5">Autoriser la conversation vocale</h2>
                        <p class="small text-secondary">
                            Pour l’appel, votre microphone transmet l’audio au fournisseur @session.Provider.
                            L’application ne conserve pas l’enregistrement.
                        </p>
                        <form asp-action="AcceptAudioConsent" method="post">
                            <input type="hidden" name="id" value="@session.Id" />
                            <input type="hidden" name="provider" value="@session.Provider" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" required id="audio-consent" />
                                <label class="form-check-label" for="audio-consent">
                                    J’accepte le traitement de mon audio pendant cet appel.
                                </label>
                            </div>
                            <button class="btn btn-outline-primary mt-3">Autoriser le microphone</button>
                        </form>
                    </div>
                </section>
            }
            else if (session.AllowAudioInput)
            {
                <form asp-action="UploadAudio" asp-route-id="@session.Id" method="post"
                      enctype="multipart/form-data" class="d-none" data-ai-audio-form>
                    <input type="file" name="audio" data-ai-audio-file
                           accept="audio/webm,audio/wav,audio/mpeg" />
                </form>
            }
        </aside>

        <main class="col-xl-5">
            <section class="card border-0 shadow-sm">
                <div class="card-header bg-body d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Conversation</h2>
                    <span class="badge text-bg-success">@session.Status</span>
                </div>
                <div class="card-body">
                    <partial name="/Views/Shared/_AiConversationHistory.cshtml" model="session" />

                    @if (session.Status == AiConversationStatus.Active && session.AllowTextInput)
                    {
                        <form asp-action="SendMessage" method="post" class="mt-3" id="ai-message-form">
                            <input asp-for="Message.SessionId" type="hidden" />
                            <label asp-for="Message.Text" class="visually-hidden"></label>
                            <div class="input-group">
                                <textarea asp-for="Message.Text" class="form-control" rows="2"
                                          maxlength="2000" required
                                          placeholder="Posez votre question…"></textarea>
                                <button class="btn btn-primary px-3" type="submit" aria-label="Envoyer">
                                    Envoyer
                                </button>
                            </div>
                            <span asp-validation-for="Message.Text" class="text-danger"></span>
                            <span class="small text-secondary d-none mt-2" id="ai-loading" role="status">
                                @session.TrainerDisplayName réfléchit…
                            </span>
                        </form>
                    }
                </div>
            </section>

            @if (session.Status == AiConversationStatus.Active)
            {
                <form asp-action="End" asp-route-id="@session.Id" method="post" class="mt-3 text-end">
                    <button class="btn btn-outline-danger" data-confirm="Terminer cette session IA ?">
                        Terminer la session
                    </button>
                </form>
            }
            <a class="btn btn-link mt-2" asp-action="History" asp-route-lessonId="@session.LessonId">
                Voir l’historique
            </a>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

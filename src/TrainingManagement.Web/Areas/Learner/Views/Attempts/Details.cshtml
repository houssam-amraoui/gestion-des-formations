@model TrainingManagement.Web.ViewModels.Attempts.AttemptPageViewModel
@{var a=Model.Attempt;ViewData["Title"]=a.AssessmentTitle;}<div class="container py-5"><div class="d-flex justify-content-between align-items-start mb-4"><div><span class="badge text-bg-warning">Tentative @a.AttemptNumber</span><h1 class="h2 fw-bold mt-2">@a.AssessmentTitle</h1></div>@if(a.RemainingSeconds is not null){<div class="alert alert-warning" data-countdown="@a.RemainingSeconds">Temps restant : <strong data-countdown-value></strong></div>}</div>
<form method="post"><input asp-for="Attempt.Id" type="hidden"/>@for(var i=0;i<a.Questions.Count;i++){var q=a.Questions.ElementAt(i);<section class="card border-0 shadow-sm mb-4"><div class="card-body"><input asp-for="Questions[i].AttemptQuestionId" type="hidden"/><div class="d-flex justify-content-between"><h2 class="h5">@q.DisplayOrder. @q.Statement</h2><span class="badge text-bg-primary">@q.Points point(s)</span></div>@if(q.QuestionType==QuestionType.ShortAnswer){<textarea asp-for="Questions[i].TextAnswer" class="form-control mt-3" rows="3"></textarea>}else{<div class="list-group mt-3">@foreach(var o in q.Options){<label class="list-group-item"><input class="form-check-input me-2" name="Questions[@i].SelectedOptionIds" value="@o.Id" type="@(q.QuestionType==QuestionType.MultipleChoice?"checkbox":"radio")" checked="@o.Selected"/>@o.Text</label>}</div>}</div></section>}<div class="d-flex gap-2"><button class="btn btn-outline-primary" asp-action="Save" asp-route-id="@a.Id">Enregistrer</button><button class="btn btn-success" asp-action="Submit" asp-route-id="@a.Id" data-confirm="Soumettre définitivement cette tentative ?">Soumettre définitivement</button></div></form></div>

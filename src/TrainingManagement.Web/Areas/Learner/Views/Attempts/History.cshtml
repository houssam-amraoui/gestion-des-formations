@model TrainingManagement.Web.ViewModels.Attempts.AttemptHistoryViewModel
@{ViewData["Title"]="Mes résultats";}<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Tableau de bord</a></li><li class="breadcrumb-item active">Mes résultats</li></ol></nav><h1 class="h2 fw-bold">Historique des tentatives</h1><form method="get" class="row g-2 mb-4"><div class="col-md-4"><select asp-for="Status" asp-items="Html.GetEnumSelectList<AttemptStatus>()" class="form-select"><option value="">Tous les statuts</option></select></div><div class="col-md-4"><select asp-for="Passed" class="form-select"><option value="">Tous les résultats</option><option value="true">Réussies</option><option value="false">Échouées</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary">Filtrer</button></div></form><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Formation</th><th>Quiz</th><th>Tentative</th><th>Statut</th><th>Score</th><th>Date</th><th></th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="7" class="text-center py-5">Aucune tentative.</td></tr>}@foreach(var x in Model.Items){<tr><td>@x.TrainingTitle</td><td>@x.AssessmentTitle</td><td>#@x.AttemptNumber</td><td><span class="badge text-bg-info">@x.Status.ToFrenchLabel()</span></td><td>@(x.PercentageScore?.ToString("N2")??"—") %</td><td>@x.StartedAt.ToLocalTime().ToString("g")</td><td>@if(x.Status!=AttemptStatus.InProgress){<a class="btn btn-sm btn-outline-primary" asp-action="Result" asp-route-id="@x.Id">Voir</a>}else{<a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@x.Id">Reprendre</a>}</td></tr>}</tbody></table></div></div></div>

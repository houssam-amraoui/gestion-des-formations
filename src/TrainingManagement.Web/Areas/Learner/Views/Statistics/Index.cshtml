@model IReadOnlyCollection<LearnerTrainingStatistics>
@{ViewData["Title"]="Mes statistiques";}
<div class="container py-5"><div class="d-flex justify-content-between"><h1 class="h2 fw-bold">Mes statistiques détaillées</h1><a class="btn btn-outline-primary" asp-controller="Certificates">Mes certificats</a></div><div class="row g-3 mt-2">@foreach(var x in Model){<div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">@x.TrainingTitle</h2><div class="progress mb-3"><div class="progress-bar" style="width:@x.Progress.ToString(System.Globalization.CultureInfo.InvariantCulture)%">@x.Progress.ToString("N0")%</div></div><dl class="row mb-0"><dt class="col-7">Leçons terminées</dt><dd class="col-5">@x.CompletedLessons</dd><dt class="col-7">Évaluations passées</dt><dd class="col-5">@x.AssessmentsTaken</dd><dt class="col-7">Meilleur score</dt><dd class="col-5">@(x.BestScore?.ToString("N2")??"—") %</dd><dt class="col-7">Moyenne</dt><dd class="col-5">@(x.AverageScore?.ToString("N2")??"—") %</dd><dt class="col-7">Certificat</dt><dd class="col-5">@(x.HasCertificate?"Obtenu":"—")</dd></dl></div></div></div>}@if(Model.Count==0){<div class="col"><div class="alert alert-light border">Aucune statistique disponible.</div></div>}</div></div>

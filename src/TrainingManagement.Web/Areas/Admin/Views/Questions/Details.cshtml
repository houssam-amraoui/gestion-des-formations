@model TrainingManagement.Web.ViewModels.Questions.QuestionDetailsViewModel
@{var q=Model.Question;ViewData["Title"]="Question";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Assessments" asp-action="Details" asp-route-id="@q.AssessmentId">@q.AssessmentTitle</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-route-assessmentId="@q.AssessmentId">Questions</a></li><li class="breadcrumb-item active">Détails</li></ol></nav><div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">@q.Statement</h1><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@q.Id">Modifier</a>@if(q.QuestionType!=QuestionType.ShortAnswer){<a class="btn btn-primary" asp-controller="AnswerOptions" asp-action="Index" asp-route-questionId="@q.Id">Gérer les réponses</a>}</div></div><div class="card border-0 shadow-sm"><div class="card-body"><span class="badge text-bg-info">@q.QuestionType.ToFrenchLabel()</span><span class="badge text-bg-primary">@q.Points point(s)</span><p class="mt-3">@q.Explanation</p>@if(q.QuestionType==QuestionType.ShortAnswer){<div class="alert alert-success"><strong>Réponse attendue :</strong> @q.ExpectedAnswer</div>}</div></div></div>

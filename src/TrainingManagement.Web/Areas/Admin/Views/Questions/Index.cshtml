@model TrainingManagement.Web.ViewModels.Questions.QuestionIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Questions";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Assessments" asp-action="Details" asp-route-id="@c.AssessmentId">@c.AssessmentTitle</a></li><li class="breadcrumb-item active">Questions</li></ol></nav><div class="d-flex justify-content-between mb-4"><div><h1 class="h2 fw-bold">Questions</h1><span class="badge text-bg-primary">Total : @c.TotalPoints points</span></div><a class="btn btn-primary" asp-action="Create" asp-route-assessmentId="@c.AssessmentId">Nouvelle question</a></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>#</th><th>Type</th><th>Énoncé</th><th>Choix</th><th>Points</th><th>État</th><th class="text-end">Actions</th></tr></thead><tbody>@if(c.Items.Count==0){<tr><td colspan="7" class="text-center py-5">Aucune question.</td></tr>}@foreach(var q in c.Items){<tr><td>@q.Order</td><td><span class="badge text-bg-info">@q.QuestionType.ToFrenchLabel()</span></td><td>@(q.Statement.Length>100?q.Statement[..100]+"…":q.Statement)</td><td>@q.AnswerOptionCount</td><td>@q.Points</td><td><span class="badge @(q.IsPublished?"text-bg-success":"text-bg-warning")">@(q.IsPublished?"Publiée":"Non publiée")</span></td><td><div class="d-flex flex-wrap justify-content-end gap-1"><form asp-action="MoveUp" asp-route-id="@q.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↑</button></form><form asp-action="MoveDown" asp-route-id="@q.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↓</button></form><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@q.Id">Détails</a>@if(q.QuestionType!=QuestionType.ShortAnswer){<a class="btn btn-sm btn-outline-info" asp-controller="AnswerOptions" asp-action="Index" asp-route-questionId="@q.Id">Réponses</a>}<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@q.Id">Modifier</a>@if(q.IsPublished){<form asp-action="Unpublish" asp-route-id="@q.Id" method="post"><button class="btn btn-sm btn-warning">Dépublier</button></form>}else{<form asp-action="Publish" asp-route-id="@q.Id" method="post"><button class="btn btn-sm btn-success">Publier</button></form>}@if(q.AnswerOptionCount==0){<form asp-action="Delete" asp-route-id="@q.Id" method="post" data-confirm="Supprimer cette question ?"><button class="btn btn-sm btn-danger">Supprimer</button></form>}</div></td></tr>}</tbody></table></div></div></div>

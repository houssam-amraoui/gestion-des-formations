@model TrainingManagement.Web.ViewModels.Questions.QuestionCreateViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="AssessmentId" type="hidden"/><div class="row g-3"><div class="col-md-8"><label asp-for="QuestionType" class="form-label"></label><select asp-for="QuestionType" asp-items="Html.GetEnumSelectList<QuestionType>()" class="form-select" data-question-type></select><div class="form-text" data-question-help>La validation complète sera effectuée lors de la publication.</div></div><div class="col-md-2"><label asp-for="Order" class="form-label"></label><input asp-for="Order" class="form-control"/></div><div class="col-md-2"><label asp-for="Points" class="form-label"></label><input asp-for="Points" class="form-control"/></div><div class="col-12"><label asp-for="Statement" class="form-label"></label><textarea asp-for="Statement" class="form-control" rows="3"></textarea><span asp-validation-for="Statement" class="text-danger"></span></div><div class="col-12"><label asp-for="Explanation" class="form-label"></label><textarea asp-for="Explanation" class="form-control" rows="3"></textarea></div><div class="col-12" data-expected-answer><label asp-for="ExpectedAnswer" class="form-label"></label><textarea asp-for="ExpectedAnswer" class="form-control" rows="2"></textarea><span asp-validation-for="ExpectedAnswer" class="text-danger"></span></div></div>

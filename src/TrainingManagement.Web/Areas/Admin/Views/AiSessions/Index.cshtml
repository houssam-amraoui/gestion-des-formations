@model AiSessionIndexViewModel
@{ ViewData["Title"] = "Sessions IA"; var usage = (AiUsageSummary)ViewBag.Usage; }
<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Administration</a></li><li class="breadcrumb-item active">Sessions IA</li></ol></nav>
<h1 class="h2 fw-bold">Sessions du formateur IA</h1>
<div class="row g-3 my-3">@foreach (var kpi in new[] { ("Sessions", usage.Sessions.ToString()), ("Utilisateurs", usage.Users.ToString()), ("Messages", usage.Messages.ToString()), ("Erreurs", $"{usage.ErrorRate:N1}%"), ("Audio", $"{usage.AudioSeconds}s"), ("Coût estimé", usage.EstimatedCost?.ToString("C4") ?? "N/D") }) { <div class="col-6 col-lg-2"><div class="card card-body h-100 border-0 shadow-sm"><small>@kpi.Item1</small><strong class="h4">@kpi.Item2</strong></div></div> }</div>
<form method="get" class="card card-body border-0 shadow-sm my-3"><div class="row g-2"><div class="col-md-3"><input asp-for="User" class="form-control" placeholder="Utilisateur"/></div><div class="col-md-2"><input asp-for="Provider" class="form-control" placeholder="Fournisseur"/></div><div class="col-md-2"><select asp-for="Status" asp-items="Html.GetEnumSelectList<AiConversationStatus>()" class="form-select"><option value="">Tous statuts</option></select></div><div class="col-md-2"><input asp-for="DateFrom" class="form-control"/></div><div class="col-md-2"><input asp-for="DateTo" class="form-control"/></div><div class="col-md-1"><button class="btn btn-primary">Filtrer</button></div></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Formation</th><th>Leçon</th><th>Utilisateur</th><th>Fournisseur</th><th>Statut</th><th>Messages</th><th>Début</th><th></th></tr></thead><tbody>
@foreach (var item in Model.Results.Items) { <tr><td>@item.TrainingTitle</td><td>@item.LessonTitle</td><td><code>@item.UserId</code></td><td>@item.Provider</td><td><span class="badge text-bg-light">@item.Status</span></td><td>@item.MessageCount</td><td>@item.StartedAt.ToString("dd/MM HH:mm") UTC</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Détails</a></td></tr> }
@if (Model.Results.Items.Count == 0) { <tr><td colspan="8" class="text-center py-5">Aucune session.</td></tr> }
</tbody></table></div></div>

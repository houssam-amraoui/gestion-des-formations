@model IReadOnlyCollection<TrainingManagement.Application.Attempts.AdminAttemptListItem>
@{ViewData["Title"]="Tentatives";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Administration</a></li><li class="breadcrumb-item active">Tentatives</li></ol></nav><h1 class="h2 fw-bold">Tentatives et résultats</h1><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Apprenant</th><th>Formation / Quiz</th><th>#</th><th>Statut</th><th>Score</th><th>Date</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="7" class="text-center py-5">Aucune tentative.</td></tr>}@foreach(var x in Model){<tr><td>@x.LearnerName</td><td>@x.TrainingTitle<br/><small>@x.AssessmentTitle</small></td><td>@x.AttemptNumber</td><td><span class="badge text-bg-info">@x.Status.ToFrenchLabel()</span></td><td>@(x.PercentageScore?.ToString("N2")??"—") %</td><td>@x.StartedAt.ToLocalTime().ToString("g")</td><td>@if(x.Status!=AttemptStatus.InProgress){<a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Résultat</a>}</td></tr>}</tbody></table></div></div></div>

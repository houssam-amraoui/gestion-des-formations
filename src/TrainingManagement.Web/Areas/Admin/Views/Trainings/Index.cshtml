@model TrainingManagement.Web.ViewModels.Trainings.TrainingListViewModel
@{ ViewData["Title"] = "Formations"; }
<div class="container-fluid admin-page px-lg-5">
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Administration</a></li><li class="breadcrumb-item active">Formations</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold mb-1">Formations</h1><p class="text-secondary mb-0">@Model.Results.TotalCount résultat(s)</p></div><a class="btn btn-primary align-self-center" asp-action="Create">Nouvelle formation</a></div>
<form method="get" class="card card-body border-0 shadow-sm mb-4"><div class="row g-2">
<div class="col-lg-3"><input class="form-control" asp-for="Filter.Search" name="search" placeholder="Rechercher par titre…" /></div>
<div class="col-lg"><select class="form-select" asp-for="Filter.CategoryId" name="categoryId" asp-items="Model.Categories"><option value="">Toutes les catégories</option></select></div>
<div class="col-lg"><select class="form-select" asp-for="Filter.Level" name="level"><option value="">Tous niveaux</option>@foreach(var level in Enum.GetValues<TrainingLevel>()){<option value="@level">@level.ToFrenchLabel()</option>}</select></div>
<div class="col-lg"><select class="form-select" asp-for="Filter.Status" name="status"><option value="">Tous statuts</option>@foreach(var status in Enum.GetValues<TrainingStatus>()){<option value="@status">@status.ToFrenchLabel()</option>}</select></div>
<div class="col-lg"><select class="form-select" asp-for="Filter.TrainerId" name="trainerId" asp-items="Model.Trainers"><option value="">Tous formateurs</option></select></div>
<div class="col-lg"><select class="form-select" asp-for="Filter.Sort" name="sort"><option value="created_desc">Plus récentes</option><option value="created_asc">Plus anciennes</option><option value="title_asc">Titre A–Z</option><option value="title_desc">Titre Z–A</option></select></div>
<div class="col-lg-auto"><button class="btn btn-dark w-100">Filtrer</button></div></div></form>
<div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Formation</th><th>Catégorie</th><th>Formateur</th><th>Niveau</th><th>Durée</th><th>Prix</th><th>Statut</th><th class="text-end">Actions</th></tr></thead><tbody>
@if(Model.Results.Items.Count==0){<tr><td colspan="8" class="text-center py-5 text-secondary">Aucune formation ne correspond aux filtres.</td></tr>}
@foreach(var item in Model.Results.Items){<tr><td><div class="d-flex align-items-center gap-3"><div class="admin-thumb">@if(!string.IsNullOrWhiteSpace(item.ThumbnailUrl)){<img src="@item.ThumbnailUrl" alt="" />}else{<span>TM</span>}</div><div><strong class="d-block">@item.Title</strong><small class="text-secondary">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small></div></div></td><td>@item.CategoryName</td><td>@(item.TrainerName ?? "—")</td><td>@item.Level.ToFrenchLabel()</td><td>@item.EstimatedDurationHours h</td><td>@if(item.IsFree){<span class="badge text-bg-info">Gratuit</span>}else{@($"{item.Price:N2} MAD")}</td><td><span class="badge @item.Status.ToBadgeClass()">@item.Status.ToFrenchLabel()</span></td><td class="text-end"><div class="d-flex justify-content-end flex-wrap gap-1"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Détails</a>@if(item.Status!=TrainingStatus.Archived){<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>}@if(item.Status!=TrainingStatus.Published&&item.Status!=TrainingStatus.Archived){<form asp-action="Publish" asp-route-id="@item.Id" method="post" data-confirm="Publier cette formation ?"><button class="btn btn-sm btn-success">Publier</button></form>}@if(item.Status==TrainingStatus.Published){<form asp-action="Unpublish" asp-route-id="@item.Id" method="post" data-confirm="Dépublier cette formation ?"><button class="btn btn-sm btn-warning">Dépublier</button></form>}@if(item.Status!=TrainingStatus.Archived){<form asp-action="Archive" asp-route-id="@item.Id" method="post" data-confirm="Archiver cette formation ? Cette action préservera les données."><button class="btn btn-sm btn-outline-danger">Archiver</button></form>}</div></td></tr>}</tbody></table></div></div>
@if(Model.Results.TotalPages>1){<nav class="mt-4"><ul class="pagination justify-content-center">@for(var p=1;p<=Model.Results.TotalPages;p++){<li class="page-item @(p==Model.Results.Page?"active":"")"><a class="page-link" asp-route-page="@p" asp-route-search="@Model.Filter.Search" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-level="@Model.Filter.Level" asp-route-status="@Model.Filter.Status" asp-route-trainerId="@Model.Filter.TrainerId" asp-route-sort="@Model.Filter.Sort">@p</a></li>}</ul></nav>}
</div>

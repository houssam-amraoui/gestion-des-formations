@model TrainingManagement.Web.ViewModels.Trainings.TrainingDetailsViewModel
@{ var item=Model.Training; ViewData["Title"]=item.Title; }
<div class="container admin-page"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Administration</a></li><li class="breadcrumb-item"><a asp-action="Index">Formations</a></li><li class="breadcrumb-item active">@item.Title</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="badge @item.Status.ToBadgeClass() mb-2">@item.Status.ToFrenchLabel()</span><h1 class="h2 fw-bold">@item.Title</h1><code>@item.Slug</code></div>@if(item.Status!=TrainingStatus.Archived){<a class="btn btn-primary align-self-start" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>}</div>
<div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body p-4"><p class="lead">@item.ShortDescription</p><div class="preserve-lines">@item.Description</div></div></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><dl class="details-list"><dt>Catégorie</dt><dd>@item.CategoryName</dd><dt>Formateur</dt><dd>@(item.TrainerName??"Non assigné")</dd><dt>Niveau</dt><dd>@item.Level.ToFrenchLabel()</dd><dt>Langue</dt><dd>@item.Language</dd><dt>Durée</dt><dd>@item.EstimatedDurationHours heures</dd><dt>Prix</dt><dd>@(item.IsFree?"Gratuit":$"{item.Price:N2} MAD")</dd><dt>Publication</dt><dd>@(item.PublishedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</dd></dl></div></div></div></div></div>

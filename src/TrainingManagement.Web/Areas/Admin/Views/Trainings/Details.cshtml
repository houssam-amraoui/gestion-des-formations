@model TrainingManagement.Web.ViewModels.Trainings.TrainingDetailsViewModel
@{var item=Model.Training;ViewData["Title"]=item.Title;}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Administration</a></li><li class="breadcrumb-item"><a asp-action="Index">Formations</a></li><li class="breadcrumb-item active">@item.Title</li></ol></nav><div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="badge @item.Status.ToBadgeClass() mb-2">@item.Status.ToFrenchLabel()</span><h1 class="h2 fw-bold">@item.Title</h1><code>@item.Slug</code></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-success" asp-controller="Enrollments" asp-action="Index" asp-route-trainingId="@item.Id">Voir les inscriptions</a><a class="btn btn-outline-primary" asp-controller="TrainingModules" asp-action="Index" asp-route-trainingId="@item.Id">Gérer les modules</a>@if(item.Status!=TrainingStatus.Archived){<a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>}</div></div><div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body p-4"><p class="lead">@item.ShortDescription</p><div class="preserve-lines">@item.Description</div></div></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body p-4"><dl><dt>Catégorie</dt><dd>@item.CategoryName</dd><dt>Formateur</dt><dd>@(item.TrainerName??"Non assigné")</dd><dt>Niveau</dt><dd>@item.Level.ToFrenchLabel()</dd><dt>Prix</dt><dd>@(item.IsFree?"Gratuit":$"{item.Price:N2} MAD")</dd></dl></div></div></div></div></div>

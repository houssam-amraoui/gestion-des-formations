@model TrainingAnalyticsModel
@{ViewData["Title"]="Statistiques formation";}<div class="container py-5"><a asp-action="Index">← Statistiques</a><h1 class="h2 fw-bold mt-2">@Model.TrainingTitle</h1>
@await Html.PartialAsync("~/Views/Shared/_AnalyticsFilter.cshtml", (TrainingManagement.Web.ViewModels.Analytics.AnalyticsFilterViewModel)ViewBag.Filter)
<div class="row g-3 my-3">@foreach(var k in new[]{("Inscriptions",Model.Enrollments.ToString()),("Actives",Model.ActiveEnrollments.ToString()),("Terminées",Model.CompletedEnrollments.ToString()),("Complétion",$"{Model.CompletionRate:N1}%"),("Progression",$"{Model.AverageProgress:N1}%"),("Réussite quiz",$"{Model.AssessmentSuccessRate:N1}%"),("Certificats",Model.Certificates.ToString())}){<div class="col-md-3"><div class="card card-body"><small>@k.Item1</small><strong class="h3">@k.Item2</strong></div></div>}</div><a class="btn btn-outline-primary" asp-controller="Exports" asp-action="TrainingAnalytics" asp-route-id="@Model.TrainingId">Exporter CSV</a><h2 class="h4 mt-4">Leçons les plus abandonnées</h2><table class="table"><thead><tr><th>Leçon</th><th>Commencées</th><th>Non terminées</th><th>Taux</th></tr></thead><tbody>@foreach(var x in Model.LessonDropOffs){<tr><td>@x.Title</td><td>@x.Started</td><td>@x.NotCompleted</td><td>@x.DropOffRate.ToString("N1")%</td></tr>}</tbody></table></div>

@model TrainingManagement.Web.ViewModels.Lessons.LessonCreateViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="TrainingModuleId" type="hidden" />
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><div class="row g-3">
<div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" data-slug-source /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" data-slug-target /><span asp-validation-for="Slug" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" class="form-control" rows="4"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Order" class="form-label"></label><input asp-for="Order" class="form-control" placeholder="À la fin" /><span asp-validation-for="Order" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="EstimatedDurationMinutes" class="form-label"></label><input asp-for="EstimatedDurationMinutes" class="form-control" /><span asp-validation-for="EstimatedDurationMinutes" class="text-danger"></span></div>
<div class="col-md-5 d-flex align-items-end"><div class="form-check form-switch mb-2"><input asp-for="IsPreview" class="form-check-input" /><label asp-for="IsPreview" class="form-check-label"></label></div></div>
</div></div></div><div class="d-flex gap-2"><button class="btn btn-primary">Enregistrer</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-moduleId="@Model.TrainingModuleId">Annuler</a></div>

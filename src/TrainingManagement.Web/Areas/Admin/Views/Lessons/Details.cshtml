@model TrainingManagement.Web.ViewModels.Lessons.LessonDetailsViewModel
@{var l=Model.Lesson;ViewData["Title"]=l.Title;}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@l.TrainingId">@l.TrainingTitle</a></li><li class="breadcrumb-item"><a asp-controller="TrainingModules" asp-action="Details" asp-route-id="@l.TrainingModuleId">@l.ModuleTitle</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-route-moduleId="@l.TrainingModuleId">Leçons</a></li><li class="breadcrumb-item active">@l.Title</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold">@l.Title</h1><code>@l.Slug</code></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-dark" asp-action="Preview" asp-route-id="@l.Id">Prévisualiser</a><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@l.Id">Modifier</a><a class="btn btn-primary" asp-controller="LessonContents" asp-action="Index" asp-route-lessonId="@l.Id">Gérer les contenus</a><a class="btn btn-success" asp-controller="Assessments" asp-action="Index" asp-route-lessonId="@l.Id">Gérer les évaluations</a></div></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><p>@(l.Summary??"Aucun résumé.")</p><div class="d-flex flex-wrap gap-4"><span>Ordre <strong>@l.Order</strong></span><span>Durée <strong>@l.EstimatedDurationMinutes min</strong></span><span>Contenus <strong>@l.ContentCount</strong></span><span>@(l.IsPreview?"Aperçu gratuit":"Réservée")</span></div></div></div></div>

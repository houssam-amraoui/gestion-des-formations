@model TrainingManagement.Web.ViewModels.Lessons.LessonIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Leçons";}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@c.TrainingId">@c.TrainingTitle</a></li><li class="breadcrumb-item"><a asp-controller="TrainingModules" asp-action="Details" asp-route-id="@c.TrainingModuleId">@c.ModuleTitle</a></li><li class="breadcrumb-item active">Leçons</li></ol></nav><div class="d-flex justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold">Leçons de @c.ModuleTitle</h1><span class="badge @(c.ModulePublished?"text-bg-success":"text-bg-warning")">@(c.ModulePublished?"Module publié":"Module non publié")</span></div><a class="btn btn-primary align-self-start" asp-action="Create" asp-route-moduleId="@c.TrainingModuleId">Nouvelle leçon</a></div>
<div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>#</th><th>Leçon</th><th>Durée</th><th>Aperçu</th><th>Contenus</th><th>État</th><th class="text-end">Actions</th></tr></thead><tbody>
@if(c.Items.Count==0){<tr><td colspan="7" class="text-center py-5 text-secondary">Aucune leçon dans ce module.</td></tr>}
@foreach(var item in c.Items){<tr class="@(item.IsArchived?"table-secondary":"")"><td>@item.Order</td><td><strong>@item.Title</strong><br/><code>@item.Slug</code></td><td>@item.EstimatedDurationMinutes min</td><td>@if(item.IsPreview){<span class="badge text-bg-info">Aperçu gratuit</span>}else{<span>Réservée</span>}</td><td>@item.ContentCount</td><td>@if(item.IsArchived){<span class="badge text-bg-secondary">Archivée</span>}else if(item.IsPublished){<span class="badge text-bg-success">Publiée</span>}else{<span class="badge text-bg-warning">Non publiée</span>}</td><td><div class="d-flex flex-wrap justify-content-end gap-1"><form asp-action="MoveUp" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↑</button></form><form asp-action="MoveDown" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↓</button></form><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Détails</a><a class="btn btn-sm btn-outline-info" asp-controller="LessonContents" asp-action="Index" asp-route-lessonId="@item.Id">Contenus</a><a class="btn btn-sm btn-outline-dark" asp-action="Preview" asp-route-id="@item.Id">Aperçu</a>@if(!item.IsArchived){<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>@if(item.IsPublished){<form asp-action="Unpublish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-warning">Dépublier</button></form>}else{<form asp-action="Publish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-success">Publier</button></form>}<form asp-action="Archive" asp-route-id="@item.Id" method="post" data-confirm="Archiver cette leçon ?"><button class="btn btn-sm btn-outline-danger">Archiver</button></form>}@if(item.ContentCount==0){<form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Supprimer cette leçon ?"><button class="btn btn-sm btn-danger">Supprimer</button></form>}</div></td></tr>}</tbody></table></div></div></div>

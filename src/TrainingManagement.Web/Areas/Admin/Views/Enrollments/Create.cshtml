@model TrainingManagement.Web.ViewModels.Enrollments.EnrollmentCreateViewModel
@{ViewData["Title"]="Nouvelle inscription";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Inscriptions</a></li><li class="breadcrumb-item active">Créer</li></ol></nav><h1 class="h2 fw-bold">Nouvelle inscription</h1><form method="post" class="card border-0 shadow-sm"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="LearnerId" class="form-label"></label><select asp-for="LearnerId" asp-items="Model.Learners" class="form-select"><option value="">Sélectionner</option></select><span asp-validation-for="LearnerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="TrainingId" class="form-label"></label><select asp-for="TrainingId" asp-items="Model.Trainings" class="form-select"><option value="">Sélectionner</option></select><span asp-validation-for="TrainingId" class="text-danger"></span></div><div class="col-12 form-check ms-2"><input asp-for="ActivateImmediately" class="form-check-input"/><label asp-for="ActivateImmediately" class="form-check-label"></label></div></div></div><div class="card-footer bg-white text-end"><button class="btn btn-primary">Créer</button></div></form></div>

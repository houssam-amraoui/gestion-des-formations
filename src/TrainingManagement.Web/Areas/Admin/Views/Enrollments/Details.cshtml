@model TrainingManagement.Web.ViewModels.Enrollments.EnrollmentDetailsViewModel
@{var x=Model.Enrollment;ViewData["Title"]="Inscription";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Inscriptions</a></li><li class="breadcrumb-item active">@x.LearnerName</li></ol></nav><div class="d-flex justify-content-between mb-4"><div><h1 class="h2 fw-bold">@x.LearnerName</h1><p>@x.LearnerEmail · @x.TrainingTitle</p></div><span class="badge text-bg-info align-self-start">@x.Status.ToFrenchLabel()</span></div><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Progression</h2><div class="progress mb-4" style="height:24px"><div class="progress-bar" style="width:@x.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%">@x.ProgressPercentage.ToString("N2") %</div></div><dl class="row"><dt class="col-sm-4">Inscription</dt><dd class="col-sm-8">@x.EnrolledAt.ToLocalTime()</dd><dt class="col-sm-4">Début</dt><dd class="col-sm-8">@(x.StartedAt?.ToLocalTime().ToString()??"—")</dd><dt class="col-sm-4">Dernière activité</dt><dd class="col-sm-8">@(x.LastAccessedAt?.ToLocalTime().ToString()??"—")</dd></dl><div class="d-flex flex-wrap gap-2">@if(x.Status==EnrollmentStatus.Pending){<form asp-action="Activate" asp-route-id="@x.Id" method="post"><button class="btn btn-success">Activer</button></form>}@if(x.Status==EnrollmentStatus.Active){<form asp-action="Suspend" asp-route-id="@x.Id" method="post" data-confirm="Suspendre cette inscription ?"><button class="btn btn-warning">Suspendre</button></form>}@if(x.Status==EnrollmentStatus.Suspended){<form asp-action="Reactivate" asp-route-id="@x.Id" method="post"><button class="btn btn-success">Réactiver</button></form>}@if(x.Status is not EnrollmentStatus.Cancelled and not EnrollmentStatus.Completed){<form asp-action="Cancel" asp-route-id="@x.Id" method="post" data-confirm="Annuler cette inscription ?"><button class="btn btn-danger">Annuler</button></form>}</div></div></div></div>

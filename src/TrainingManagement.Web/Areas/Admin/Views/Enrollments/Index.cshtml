@model TrainingManagement.Web.ViewModels.Enrollments.EnrollmentIndexViewModel
@{ViewData["Title"]="Inscriptions";var pages=(int)Math.Ceiling(Model.Results.TotalCount/(double)Model.Results.PageSize);}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Administration</a></li><li class="breadcrumb-item active">Inscriptions</li></ol></nav>
<div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Inscriptions</h1><a class="btn btn-primary" asp-action="Create">Nouvelle inscription</a></div>
<form method="get" class="card border-0 shadow-sm mb-4"><div class="card-body row g-3"><div class="col-md-5"><input asp-for="Search" class="form-control" placeholder="Nom ou e-mail"/></div><div class="col-md-3"><select asp-for="TrainingId" asp-items="Model.Trainings" class="form-select"><option value="">Toutes les formations</option></select></div><div class="col-md-2"><select asp-for="Status" asp-items="Html.GetEnumSelectList<EnrollmentStatus>()" class="form-select"><option value="">Tous les statuts</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrer</button></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Apprenant</th><th>Formation</th><th>Statut</th><th>Progression</th><th>Inscription</th><th>Dernière activité</th><th></th></tr></thead><tbody>@if(Model.Results.Items.Count==0){<tr><td colspan="7" class="text-center py-5">Aucune inscription.</td></tr>}@foreach(var x in Model.Results.Items){<tr><td><strong>@x.LearnerName</strong><br/><small>@x.LearnerEmail</small></td><td>@x.TrainingTitle</td><td><span class="badge text-bg-info">@x.Status.ToFrenchLabel()</span></td><td><div class="progress" style="min-width:120px"><div class="progress-bar" style="width:@x.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%">@x.ProgressPercentage.ToString("N0")%</div></div></td><td>@x.EnrolledAt.ToLocalTime().ToString("g")</td><td>@(x.LastAccessedAt?.ToLocalTime().ToString("g")??"—")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Détails</a></td></tr>}</tbody></table></div></div>
@if(pages>1){<nav class="mt-4"><ul class="pagination">@for(var i=1;i<=pages;i++){<li class="page-item @(i==Model.Results.Page?"active":"")"><a class="page-link" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-trainingId="@Model.TrainingId" asp-route-status="@Model.Status">@i</a></li>}</ul></nav>}</div>

@model TrainingManagement.Web.ViewModels.LessonContents.LessonContentDetailsViewModel
@{var c=Model.Content;ViewData["Title"]=c.Title??c.ContentType.ToFrenchLabel();}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-id="@c.LessonId">@c.LessonTitle</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-route-lessonId="@c.LessonId">Contenus</a></li><li class="breadcrumb-item active">Détails</li></ol></nav><div class="d-flex justify-content-between mb-4"><div><span class="badge text-bg-light">@c.ContentType.ToFrenchLabel()</span><h1 class="h2 fw-bold mt-2">@(c.Title??"Sans titre")</h1></div><a class="btn btn-primary align-self-start" asp-action="Edit" asp-route-id="@c.Id">Modifier</a></div><div class="card border-0 shadow-sm"><div class="card-body p-4">@if(c.ContentType==LessonContentType.Text){<div class="preserve-lines">@c.TextContent</div>}else{<p><a href="@c.ExternalUrl" target="_blank" rel="noopener noreferrer">@c.ExternalUrl</a></p>}@if(!string.IsNullOrWhiteSpace(c.Description)){<hr/><p class="text-secondary">@c.Description</p>}</div></div></div>

@model TrainingManagement.Web.ViewModels.LessonContents.LessonContentIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Contenus";}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@c.TrainingId">@c.TrainingTitle</a></li><li class="breadcrumb-item"><a asp-controller="TrainingModules" asp-action="Details" asp-route-id="@c.TrainingModuleId">@c.ModuleTitle</a></li><li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-id="@c.LessonId">@c.LessonTitle</a></li><li class="breadcrumb-item active">Contenus</li></ol></nav><div class="d-flex justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold">Contenus de @c.LessonTitle</h1><p class="text-secondary">@c.Items.Count bloc(s), affichés dans l’ordre.</p></div><a class="btn btn-primary align-self-start" asp-action="Create" asp-route-lessonId="@c.LessonId">Nouveau contenu</a></div>
<div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>#</th><th>Titre</th><th>Type</th><th>Aperçu</th><th>Statut</th><th class="text-end">Actions</th></tr></thead><tbody>
@if(c.Items.Count==0){<tr><td colspan="6" class="text-center py-5 text-secondary">Aucun contenu. Une leçon doit avoir du contenu avant publication.</td></tr>}
@foreach(var item in c.Items){<tr><td>@item.Order</td><td>@(item.Title??"Sans titre")</td><td><span class="badge text-bg-light">@item.ContentType.ToFrenchLabel()</span></td><td class="content-preview-cell">@item.Preview</td><td><span class="badge @(item.IsPublished?"text-bg-success":"text-bg-warning")">@(item.IsPublished?"Publié":"Non publié")</span></td><td><div class="d-flex flex-wrap justify-content-end gap-1"><form asp-action="MoveUp" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↑</button></form><form asp-action="MoveDown" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↓</button></form><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Détails</a><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>@if(item.IsPublished){<form asp-action="Unpublish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-warning">Dépublier</button></form>}else{<form asp-action="Publish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-success">Publier</button></form>}<form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Supprimer ce bloc ?"><button class="btn btn-sm btn-outline-danger">Supprimer</button></form></div></td></tr>}</tbody></table></div></div></div>

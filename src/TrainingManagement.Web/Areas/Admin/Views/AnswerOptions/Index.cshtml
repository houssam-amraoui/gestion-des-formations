@model TrainingManagement.Web.ViewModels.AnswerOptions.AnswerOptionIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Réponses";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Questions" asp-action="Details" asp-route-id="@c.QuestionId">Question</a></li><li class="breadcrumb-item active">Réponses</li></ol></nav><div class="d-flex justify-content-between mb-4"><div><h1 class="h2 fw-bold">Choix de réponses</h1><p>@c.Statement</p><span class="badge text-bg-info">@c.QuestionType.ToFrenchLabel()</span></div><div>@if(c.QuestionType==QuestionType.TrueFalse&&c.Items.Count==0){<form asp-action="CreateTrueFalse" asp-route-questionId="@c.QuestionId" method="post"><button class="btn btn-outline-primary">Créer les réponses Vrai/Faux</button></form>}else{<a class="btn btn-primary" asp-action="Create" asp-route-questionId="@c.QuestionId">Nouvelle réponse</a>}</div></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>#</th><th>Texte</th><th>Correction</th><th class="text-end">Actions</th></tr></thead><tbody>@if(c.Items.Count==0){<tr><td colspan="4" class="text-center py-5">Aucune réponse.</td></tr>}@foreach(var x in c.Items){<tr><td>@x.Order</td><td>@x.Text</td><td><span class="badge @(x.IsCorrect?"text-bg-success":"text-bg-secondary")">@(x.IsCorrect?"Correcte":"Incorrecte")</span></td><td><div class="d-flex justify-content-end gap-1"><form asp-action="MoveUp" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↑</button></form><form asp-action="MoveDown" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↓</button></form><form asp-action="ToggleCorrect" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-success">Basculer correcte</button></form><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Modifier</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" data-confirm="Supprimer cette réponse ?"><button class="btn btn-sm btn-danger">Supprimer</button></form></div></td></tr>}</tbody></table></div></div></div>

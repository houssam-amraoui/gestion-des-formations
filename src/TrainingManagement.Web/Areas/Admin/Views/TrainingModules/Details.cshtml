@model TrainingManagement.Web.ViewModels.Modules.TrainingModuleDetailsViewModel
@{var m=Model.Module;ViewData["Title"]=m.Title;}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@m.TrainingId">@m.TrainingTitle</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-route-trainingId="@m.TrainingId">Modules</a></li><li class="breadcrumb-item active">@m.Title</li></ol></nav><div class="d-flex justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold">@m.Title</h1><code>@m.Slug</code></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">Modifier</a><a class="btn btn-primary" asp-controller="Lessons" asp-action="Index" asp-route-moduleId="@m.Id">Gérer les leçons</a></div></div><div class="card border-0 shadow-sm"><div class="card-body p-4"><p>@(m.Description??"Aucune description.")</p><div class="d-flex gap-3"><span>Ordre : <strong>@m.Order</strong></span><span>Leçons : <strong>@m.LessonCount</strong></span><span>État : <strong>@(m.IsArchived?"Archivé":m.IsPublished?"Publié":"Non publié")</strong></span></div></div></div></div>

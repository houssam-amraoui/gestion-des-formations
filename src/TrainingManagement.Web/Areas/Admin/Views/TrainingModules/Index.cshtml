@model TrainingManagement.Web.ViewModels.Modules.TrainingModuleIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Modules";}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Index">Formations</a></li><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@c.TrainingId">@c.TrainingTitle</a></li><li class="breadcrumb-item active">Modules</li></ol></nav>
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold">Modules de @c.TrainingTitle</h1><span class="badge @c.TrainingStatus.ToBadgeClass()">@c.TrainingStatus.ToFrenchLabel()</span> <span class="text-secondary">@c.Items.Count module(s)</span></div><a class="btn btn-primary align-self-start" asp-action="Create" asp-route-trainingId="@c.TrainingId">Nouveau module</a></div>
<div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>#</th><th>Module</th><th>Leçons</th><th>État</th><th class="text-end">Actions</th></tr></thead><tbody>
@if(c.Items.Count==0){<tr><td colspan="5" class="text-center py-5 text-secondary">Aucun module. Commencez à structurer cette formation.</td></tr>}
@foreach(var item in c.Items){<tr class="@(item.IsArchived?"table-secondary":"")"><td class="fw-bold">@item.Order</td><td><strong>@item.Title</strong><br/><code>@item.Slug</code></td><td>@item.LessonCount</td><td>@if(item.IsArchived){<span class="badge text-bg-secondary">Archivé</span>}else if(item.IsPublished){<span class="badge text-bg-success">Publié</span>}else{<span class="badge text-bg-warning">Non publié</span>}</td><td class="text-end"><div class="d-flex flex-wrap gap-1 justify-content-end"><form asp-action="MoveUp" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-secondary" title="Monter">↑</button></form><form asp-action="MoveDown" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-outline-secondary" title="Descendre">↓</button></form><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Détails</a><a class="btn btn-sm btn-outline-info" asp-controller="Lessons" asp-action="Index" asp-route-moduleId="@item.Id">Leçons</a>@if(!item.IsArchived){<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Modifier</a>@if(item.IsPublished){<form asp-action="Unpublish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-warning">Dépublier</button></form>}else{<form asp-action="Publish" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-success">Publier</button></form>}<form asp-action="Archive" asp-route-id="@item.Id" method="post" data-confirm="Archiver ce module ?"><button class="btn btn-sm btn-outline-danger">Archiver</button></form>}@if(item.LessonCount==0){<form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="Supprimer ce module ?"><button class="btn btn-sm btn-danger">Supprimer</button></form>}</div></td></tr>}</tbody></table></div></div></div>

@model TrainingManagement.Web.ViewModels.Assessments.AssessmentIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Évaluations";}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@c.TrainingId">@c.TrainingTitle</a></li><li class="breadcrumb-item"><a asp-controller="TrainingModules" asp-action="Details" asp-route-id="@c.ModuleId">@c.ModuleTitle</a></li><li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-id="@c.LessonId">@c.LessonTitle</a></li><li class="breadcrumb-item active">Évaluations</li></ol></nav><div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Évaluations</h1><a class="btn btn-primary" asp-action="Create" asp-route-lessonId="@c.LessonId">Nouvelle évaluation</a></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>#</th><th>Titre</th><th>Type</th><th>Questions / points</th><th>Paramètres</th><th>État</th><th class="text-end">Actions</th></tr></thead><tbody>@if(c.Items.Count==0){<tr><td colspan="7" class="text-center py-5">Aucune évaluation.</td></tr>}@foreach(var x in c.Items){<tr class="@(x.IsArchived?"table-secondary":"")"><td>@x.Order</td><td><strong>@x.Title</strong><br/><code>@x.Slug</code></td><td><span class="badge text-bg-info">@x.AssessmentType.ToFrenchLabel()</span></td><td>@x.QuestionCount question(s) · @x.TotalPoints points</td><td>Seuil @x.PassingScore %<br/><small>@(x.TimeLimitMinutes is null?"Sans limite":$"{x.TimeLimitMinutes} min") · @(x.MaximumAttempts is null?"Illimité":$"{x.MaximumAttempts} tentative(s)")</small></td><td>@if(x.IsArchived){<span class="badge text-bg-secondary">Archivée</span>}else if(x.IsPublished){<span class="badge text-bg-success">Publiée</span>}else{<span class="badge text-bg-warning">Non publiée</span>}</td><td><div class="d-flex flex-wrap justify-content-end gap-1"><form asp-action="MoveUp" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↑</button></form><form asp-action="MoveDown" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-secondary">↓</button></form><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Id">Détails</a><a class="btn btn-sm btn-outline-info" asp-controller="Questions" asp-action="Index" asp-route-assessmentId="@x.Id">Questions</a><a class="btn btn-sm btn-outline-dark" asp-action="Preview" asp-route-id="@x.Id">Aperçu</a>@if(!x.IsArchived){<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Modifier</a>@if(x.IsPublished){<form asp-action="Unpublish" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-warning">Dépublier</button></form>}else{<form asp-action="Publish" asp-route-id="@x.Id" method="post" data-confirm="Publier cette évaluation ?"><button class="btn btn-sm btn-success">Publier</button></form>}<form asp-action="Archive" asp-route-id="@x.Id" method="post" data-confirm="Archiver cette évaluation ?"><button class="btn btn-sm btn-outline-danger">Archiver</button></form>}@if(x.QuestionCount==0){<form asp-action="Delete" asp-route-id="@x.Id" method="post" data-confirm="Supprimer cette évaluation ?"><button class="btn btn-sm btn-danger">Supprimer</button></form>}</div></td></tr>}</tbody></table></div></div></div>

@model TrainingManagement.Web.ViewModels.Assessments.AssessmentDetailsViewModel
@{var x=Model.Assessment;ViewData["Title"]=x.Title;}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-id="@x.LessonId">@x.LessonTitle</a></li><li class="breadcrumb-item"><a asp-action="Index" asp-route-lessonId="@x.LessonId">Évaluations</a></li><li class="breadcrumb-item active">@x.Title</li></ol></nav><div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="h2 fw-bold">@x.Title</h1><code>@x.Slug</code></div><div class="d-flex gap-2"><a class="btn btn-outline-dark" asp-action="Preview" asp-route-id="@x.Id">Prévisualiser</a><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Modifier</a><a class="btn btn-primary" asp-controller="Questions" asp-action="Index" asp-route-assessmentId="@x.Id">Gérer les questions</a></div></div><div class="card border-0 shadow-sm"><div class="card-body p-4"><p>@(x.Description??"Aucune description.")</p><div class="d-flex flex-wrap gap-4"><span class="badge text-bg-info">@x.AssessmentType.ToFrenchLabel()</span><span>Ordre <strong>@x.Order</strong></span><span>Questions <strong>@x.QuestionCount</strong></span><span>Total <strong>@x.TotalPoints points</strong></span><span>Seuil <strong>@x.PassingScore %</strong></span></div></div></div></div>

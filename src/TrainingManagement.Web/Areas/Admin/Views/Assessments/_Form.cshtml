@model TrainingManagement.Web.ViewModels.Assessments.AssessmentCreateViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="LessonId" type="hidden"/>
<div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-md-4"><label asp-for="AssessmentType" class="form-label"></label><select asp-for="AssessmentType" asp-items="Html.GetEnumSelectList<AssessmentType>()" class="form-select"></select></div>
<div class="col-md-8"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control"/><div class="form-text">Vide : généré depuis le titre.</div><span asp-validation-for="Slug" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Order" class="form-label"></label><input asp-for="Order" class="form-control"/><span asp-validation-for="Order" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="PassingScore" class="form-label"></label><input asp-for="PassingScore" class="form-control"/><span asp-validation-for="PassingScore" class="text-danger"></span></div><div class="col-md-4"><label asp-for="TimeLimitMinutes" class="form-label"></label><input asp-for="TimeLimitMinutes" class="form-control"/><span asp-validation-for="TimeLimitMinutes" class="text-danger"></span></div><div class="col-md-4"><label asp-for="MaximumAttempts" class="form-label"></label><input asp-for="MaximumAttempts" class="form-control"/><span asp-validation-for="MaximumAttempts" class="text-danger"></span></div>
<div class="col-md-6 form-check ms-2"><input asp-for="ShuffleQuestions" class="form-check-input"/><label asp-for="ShuffleQuestions" class="form-check-label"></label></div><div class="col-md-5 form-check"><input asp-for="ShowCorrectAnswers" class="form-check-input"/><label asp-for="ShowCorrectAnswers" class="form-check-label"></label></div></div>

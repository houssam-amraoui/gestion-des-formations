@model TrainingManagement.Web.ViewModels.Assessments.AssessmentPreviewViewModel
@{var p=Model.Preview;var a=p.Assessment;ViewData["Title"]="Aperçu — "+a.Title;}<div class="container py-5"><div class="alert alert-info fw-semibold">Mode aperçu administrateur — aucune réponse ne sera enregistrée.</div><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@a.Id">@a.Title</a></li><li class="breadcrumb-item active">Aperçu</li></ol></nav><h1>@a.Title</h1><p class="lead">@a.Description</p><div class="d-flex flex-wrap gap-2 mb-4"><span class="badge text-bg-info">@a.AssessmentType.ToFrenchLabel()</span><span class="badge text-bg-light">@a.PassingScore % requis</span><span class="badge text-bg-light">@(a.TimeLimitMinutes is null?"Sans limite":$"{a.TimeLimitMinutes} minutes")</span><span class="badge text-bg-light">@(a.MaximumAttempts is null?"Tentatives illimitées":$"{a.MaximumAttempts} tentatives")</span></div>
@foreach(var q in p.Questions){<section class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@q.Order. @q.Statement</h2><span class="badge text-bg-primary">@q.Points point(s)</span></div><span class="badge text-bg-secondary">@q.QuestionType.ToFrenchLabel()</span>@if(!q.IsPublished){<span class="badge text-bg-warning">Non publiée</span>}@if(q.QuestionType==QuestionType.ShortAnswer){<div class="alert alert-success mt-3"><strong>Réponse attendue :</strong> @q.ExpectedAnswer</div>}else{<ol class="list-group list-group-numbered mt-3">@foreach(var o in q.Options){<li class="list-group-item d-flex justify-content-between">@o.Text @if(o.IsCorrect){<span class="badge text-bg-success">Bonne réponse</span>}</li>}</ol>}@if(!string.IsNullOrWhiteSpace(q.Explanation)){<div class="mt-3"><strong>Explication :</strong> @q.Explanation</div>}</div></section>}</div>

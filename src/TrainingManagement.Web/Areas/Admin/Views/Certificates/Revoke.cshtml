@model TrainingManagement.Web.ViewModels.Certificates.CertificateRevokeViewModel
@{ViewData["Title"]="Révoquer";}<div class="container py-5" style="max-width:720px"><h1 class="h2">Révoquer @Model.CertificateNumber</h1><div class="alert alert-warning">Le certificat restera dans l’historique mais ne sera plus valide publiquement.</div><form method="post"><input asp-for="Id" type="hidden"/><input asp-for="CertificateNumber" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Reason" class="form-label">Raison</label><textarea asp-for="Reason" class="form-control" rows="5"></textarea><span asp-validation-for="Reason" class="text-danger"></span><button class="btn btn-danger mt-3">Confirmer la révocation</button></form></div>

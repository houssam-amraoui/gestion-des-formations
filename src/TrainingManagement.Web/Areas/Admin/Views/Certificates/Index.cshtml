@model TrainingManagement.Web.ViewModels.Certificates.CertificateIndexViewModel
@{ViewData["Title"]="Certificats";}<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Administration</a></li><li class="breadcrumb-item active">Certificats</li></ol></nav><div class="d-flex justify-content-between"><h1 class="h2 fw-bold">Certificats</h1><a class="btn btn-outline-primary" asp-controller="Exports" asp-action="Certificates">Exporter CSV</a></div>
<form method="get" class="row g-2 my-3"><div class="col-md-5"><input name="search" value="@Model.Search" class="form-control" placeholder="Numéro, apprenant ou formation"/></div><div class="col-md-3"><select name="status" asp-items="Html.GetEnumSelectList<CertificateStatus>()" class="form-select"><option value="">Tous les statuts</option></select></div><div class="col-md-2"><button class="btn btn-primary">Filtrer</button></div></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Numéro</th><th>Apprenant</th><th>Formation</th><th>Réussite</th><th>Émission</th><th>Expiration</th><th>Statut</th><th></th></tr></thead><tbody>@if(Model.Results.Items.Count==0){<tr><td colspan="8" class="text-center py-5">Aucun certificat.</td></tr>}@foreach(var x in Model.Results.Items){<tr><td><code>@x.CertificateNumber</code></td><td>@x.LearnerFullName</td><td>@x.TrainingTitle</td><td>@x.CompletionDate.ToString("dd/MM/yyyy")</td><td>@x.IssuedAt.ToString("dd/MM/yyyy")</td><td>@(x.ExpiresAt?.ToString("dd/MM/yyyy")??"—")</td><td>@x.Status</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Détails</a></td></tr>}</tbody></table></div></div>

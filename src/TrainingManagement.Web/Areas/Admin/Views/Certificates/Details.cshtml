@model CertificateDetailsModel
@{ViewData["Title"]="Certificat";}<div class="container py-5"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Certificats</a></li><li class="breadcrumb-item active">Détails</li></ol></nav><partial name="Certificates/_Details" model="Model"/><div class="d-flex gap-2 mt-3"><a class="btn btn-primary" asp-action="Download" asp-route-id="@Model.Id">Télécharger</a><form method="post" asp-action="Regenerate" asp-route-id="@Model.Id"><button class="btn btn-outline-primary" data-confirm="Régénérer le PDF ?">Régénérer le PDF</button></form>@if(Model.Status==CertificateStatus.Revoked){<form method="post" asp-action="Reactivate" asp-route-id="@Model.Id"><button class="btn btn-success">Réactiver</button></form>}else{<a class="btn btn-danger" asp-action="Revoke" asp-route-id="@Model.Id">Révoquer</a>}</div></div>

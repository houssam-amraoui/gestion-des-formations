@model TrainingManagement.Web.ViewModels.Categories.CategoryCreateViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4">
    <h2 class="h5 mb-4">Informations générales</h2>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" data-slug-source /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" data-slug-target /><div class="form-text">Laissez vide pour le générer depuis le nom.</div><span asp-validation-for="Slug" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" /><span asp-validation-for="ImageUrl" class="text-danger"></span></div>
    </div>
</div></div>
<div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Enregistrer</button><a class="btn btn-outline-secondary" asp-action="Index">Annuler</a></div>

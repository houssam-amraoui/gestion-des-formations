@model AdminDashboardAnalytics
@{ViewData["Title"]="Administration";var ai=(AiUsageSummary)ViewBag.AiUsage;}
<div class="container dashboard-page"><div class="dashboard-shell"><aside><span class="badge text-bg-primary mb-3">Admin</span><h1 class="h4">Administration</h1><nav class="nav flex-column mt-4"><a class="nav-link active" asp-controller="Dashboard">Vue d’ensemble</a><a class="nav-link" asp-controller="Categories">Catégories</a><a class="nav-link" asp-controller="Trainings">Formations</a><a class="nav-link" asp-controller="Enrollments">Inscriptions</a><a class="nav-link" asp-controller="Certificates">Certificats</a><a class="nav-link" asp-controller="Analytics">Statistiques</a><a class="nav-link" asp-controller="AiTrainerProfiles">Formateurs IA</a><a class="nav-link" asp-controller="AiSessions">Sessions IA</a></nav></aside><section><p class="text-secondary mb-1">Tableau de bord</p><h2 class="fw-bold">Vue d’ensemble</h2><div class="row g-3"><div class="col-md-3"><div class="dashboard-stat"><strong>@Model.TotalUsers</strong><span>utilisateurs</span></div></div><div class="col-md-3"><div class="dashboard-stat"><strong>@Model.ActiveEnrollments</strong><span>inscriptions actives</span></div></div><div class="col-md-3"><div class="dashboard-stat"><strong>@Model.CertificatesIssued</strong><span>certificats émis</span></div></div><div class="col-md-3"><div class="dashboard-stat"><strong>@ai.Sessions</strong><span>sessions IA aujourd’hui</span></div></div></div><div class="mt-4"><a class="btn btn-primary" asp-controller="Analytics">Statistiques avancées</a> <a class="btn btn-outline-primary" asp-controller="AiTrainerProfiles">Configurer l’IA</a> <a class="btn btn-outline-primary" asp-controller="AiSessions">Suivre les sessions IA</a></div></section></div></div>

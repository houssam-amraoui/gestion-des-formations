@model IReadOnlyCollection<CertificateListItem>
@{ViewData["Title"]="Certificats";}<div class="container py-5"><h1 class="h2 fw-bold">Certificats de mes formations</h1><div class="table-responsive"><table class="table"><thead><tr><th>Apprenant</th><th>Formation</th><th>Numéro</th><th>Émission</th><th>Statut</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="text-center py-4">Aucun certificat.</td></tr>}@foreach(var x in Model){<tr><td>@x.LearnerFullName</td><td>@x.TrainingTitle</td><td>@x.CertificateNumber</td><td>@x.IssuedAt.ToString("dd/MM/yyyy")</td><td>@x.Status</td><td><a asp-action="Details" asp-route-id="@x.Id">Consulter</a></td></tr>}</tbody></table></div></div>

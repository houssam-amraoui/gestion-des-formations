@model IReadOnlyCollection<TrainingManagement.Application.Attempts.TrainerLearnerProgressItem>
@{ViewData["Title"]="Progression des apprenants";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Espace formateur</a></li><li class="breadcrumb-item active">Progression</li></ol></nav><div class="d-flex justify-content-between mb-4"><h1 class="h2 fw-bold">Progression des apprenants</h1><a class="btn btn-outline-primary" asp-controller="AssessmentResults">Résultats des quiz</a></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Apprenant</th><th>Formation</th><th>Statut</th><th>Progression</th><th>Leçons</th><th>Quiz</th><th>Moyenne</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="7" class="text-center py-5">Aucun apprenant inscrit à vos formations.</td></tr>}@foreach(var x in Model){<tr><td><strong>@x.LearnerName</strong><br/><small>@x.LearnerEmail</small></td><td>@x.TrainingTitle</td><td>@x.Status.ToFrenchLabel()</td><td><div class="progress"><div class="progress-bar" style="width:@x.Progress.ToString(System.Globalization.CultureInfo.InvariantCulture)%">@x.Progress.ToString("N0")%</div></div></td><td>@x.CompletedLessons / @x.TotalLessons</td><td>@x.SubmittedAttempts</td><td>@(x.AverageScore?.ToString("N2")??"—") %</td></tr>}</tbody></table></div></div></div>

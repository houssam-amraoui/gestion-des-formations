@model IReadOnlyCollection<TrainingManagement.Application.Attempts.AdminAttemptListItem>
@{ViewData["Title"]="Résultats";}<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Dashboard">Espace formateur</a></li><li class="breadcrumb-item active">Résultats</li></ol></nav><h1 class="h2 fw-bold">Résultats des quiz</h1><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Apprenant</th><th>Formation</th><th>Quiz</th><th>Statut</th><th>Score</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="text-center py-5">Aucun résultat.</td></tr>}@foreach(var x in Model){<tr><td>@x.LearnerName</td><td>@x.TrainingTitle</td><td>@x.AssessmentTitle · #@x.AttemptNumber</td><td>@x.Status.ToFrenchLabel()</td><td>@(x.PercentageScore?.ToString("N2")??"—") %</td><td>@if(x.Status!=AttemptStatus.InProgress){<a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@x.Id">Détails</a>}</td></tr>}</tbody></table></div></div></div>

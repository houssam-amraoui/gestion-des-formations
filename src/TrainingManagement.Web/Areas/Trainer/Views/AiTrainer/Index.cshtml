@model IReadOnlyCollection<AiTrainerProfileListItem>
@{ ViewData["Title"] = "Formateur IA"; var usage = (AiUsageSummary)ViewBag.Usage; }
<div class="container py-5"><h1 class="h2">Formateur IA de mes formations</h1>
<div class="row g-3 my-3"><div class="col-md-3"><div class="card card-body"><small>Sessions</small><strong class="h3">@usage.Sessions</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Apprenants</small><strong class="h3">@usage.Users</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Messages</small><strong class="h3">@usage.Messages</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Erreurs</small><strong class="h3">@usage.ErrorRate.ToString("N1")%</strong></div></div></div>
<div class="row g-3">@foreach (var item in Model) { <div class="col-lg-6"><div class="card card-body border-0 shadow-sm h-100"><h2 class="h5">@item.DisplayName</h2><p>@item.TrainingTitle</p><div><span class="badge text-bg-info">@item.Provider</span> <span class="badge text-bg-@(item.IsEnabled ? "success" : "secondary")">@(item.IsEnabled ? "Actif" : "Désactivé")</span></div><form asp-action="Start" method="post" class="mt-3"><label class="form-label" for="lesson-@item.Id">Identifiant de leçon à tester</label><input id="lesson-@item.Id" name="lessonId" type="number" min="1" class="form-control" required/><button class="btn btn-primary mt-2">Tester</button></form></div></div> }</div>
<a asp-action="History" class="btn btn-outline-primary mt-4">Historique de mes formations</a></div>

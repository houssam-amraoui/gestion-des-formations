@model IReadOnlyCollection<AiSessionListItem>
@{ ViewData["Title"] = "Sessions IA"; }
<div class="container py-5"><h1 class="h2">Sessions IA de mes formations</h1><div class="table-responsive"><table class="table"><thead><tr><th>Formation</th><th>Leçon</th><th>Utilisateur</th><th>Statut</th><th>Messages</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.TrainingTitle</td><td>@item.LessonTitle</td><td><code>@item.UserId</code></td><td>@item.Status</td><td>@item.MessageCount</td><td><a asp-action="Session" asp-route-id="@item.Id">Consulter</a></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="text-center py-5">Aucune session.</td></tr>}</tbody></table></div></div>

@model AiSessionPageViewModel
@{ ViewData["Title"] = "Test du formateur IA"; }
<div class="container py-4">
    <h1 class="h2">Appel test — @Model.Session.TrainerDisplayName</h1>
    <p class="text-secondary">@Model.Session.TrainingTitle · @Model.Session.LessonTitle</p>
    <div class="alert alert-info">Ce test est limité aux formations qui vous sont affectées.</div>
    <div class="row g-4">
        <div class="col-xl-7">
            <partial name="/Views/Shared/_AiAvatarPanel.cshtml" model="Model.Session" />
        </div>
        <div class="col-xl-5">
            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <partial name="/Views/Shared/_AiConversationHistory.cshtml" model="Model.Session" />
                    @if (Model.Session.Status == AiConversationStatus.Active)
                    {
                        <form asp-action="SendMessage" method="post" class="mt-3" id="ai-message-form">
                            <input asp-for="Message.SessionId" type="hidden" />
                            <textarea asp-for="Message.Text" class="form-control" rows="3" required
                                      placeholder="Tester une question…"></textarea>
                            <button class="btn btn-primary mt-2">Envoyer</button>
                        </form>
                        <form asp-action="End" asp-route-id="@Model.Session.Id" method="post" class="mt-2">
                            <button class="btn btn-outline-danger">Terminer</button>
                        </form>
                    }
                </div>
            </section>
        </div>
    </div>
</div>

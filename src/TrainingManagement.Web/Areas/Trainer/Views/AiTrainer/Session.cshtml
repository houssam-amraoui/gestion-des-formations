@model AiSessionPageViewModel
@{ ViewData["Title"] = "Test IA"; }
<div class="container py-5"><h1 class="h2">Test Trainer — @Model.Session.LessonTitle</h1><div class="alert alert-info">Lecture et test limités à vos formations. La configuration globale reste réservée à l’Admin.</div><div class="row g-4"><div class="col-lg-4"><partial name="/Views/Shared/_AiAvatarPanel.cshtml" model="Model.Session"/><div class="card card-body mt-3"><strong>Statut : @Model.Session.Status</strong><span>@Model.Session.RemainingMessages messages restants</span></div></div><div class="col-lg-8"><partial name="/Views/Shared/_AiConversationHistory.cshtml" model="Model.Session"/>
@if(Model.Session.Status==AiConversationStatus.Active){<form asp-action="SendMessage" method="post" class="mt-3"><input asp-for="Message.SessionId" type="hidden"/><textarea asp-for="Message.Text" class="form-control" rows="3" required></textarea><button class="btn btn-primary mt-2">Envoyer</button></form><form asp-action="End" asp-route-id="@Model.Session.Id" method="post" class="mt-2"><button class="btn btn-outline-danger">Terminer</button></form>}</div></div></div>

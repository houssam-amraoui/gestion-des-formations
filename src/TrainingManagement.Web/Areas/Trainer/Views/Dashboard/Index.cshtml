@model TrainerDashboardAnalytics
@{ViewData["Title"]="Espace formateur";var ai=(AiUsageSummary)ViewBag.AiUsage;}
<div class="container dashboard-page"><div class="dashboard-shell"><aside><span class="badge text-bg-warning mb-3">Trainer</span><h1 class="h4">Espace formateur</h1><nav class="nav flex-column mt-4"><a class="nav-link active" asp-controller="Dashboard">Vue d’ensemble</a><a class="nav-link" asp-controller="Trainings">Mes formations</a><a class="nav-link" asp-controller="LearnerProgress">Progression</a><a class="nav-link" asp-controller="Certificates">Certificats</a><a class="nav-link" asp-controller="Analytics">Statistiques</a><a class="nav-link" asp-controller="AiTrainer">Formateur IA</a></nav></aside><section><p class="text-secondary mb-1">Tableau de bord</p><h2 class="fw-bold">Mes indicateurs</h2><div class="row g-3"><div class="col-md-3"><div class="dashboard-stat"><strong>@Model.Learners</strong><span>apprenants</span></div></div><div class="col-md-3"><div class="dashboard-stat"><strong>@Model.AverageProgress.ToString("N1")%</strong><span>progression moyenne</span></div></div><div class="col-md-3"><div class="dashboard-stat"><strong>@Model.Certificates</strong><span>certificats</span></div></div><div class="col-md-3"><div class="dashboard-stat"><strong>@ai.Sessions</strong><span>sessions IA (30 j)</span></div></div></div><div class="mt-4"><a class="btn btn-primary" asp-controller="Trainings">Mes formations</a> <a class="btn btn-outline-primary" asp-controller="AiTrainer">Consulter le formateur IA</a></div></section></div></div>

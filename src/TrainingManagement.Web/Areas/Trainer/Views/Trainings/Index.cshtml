@model IReadOnlyCollection<TrainingManagement.Application.Pedagogy.TrainerTrainingItem>
@{ViewData["Title"]="Mes formations";}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-area="Trainer" asp-controller="Dashboard">Espace formateur</a></li><li class="breadcrumb-item active">Mes formations</li></ol></nav><div class="mb-4"><span class="badge text-bg-success">Lecture seule</span><h1 class="h2 fw-bold mt-2">Mes formations assignées</h1><p class="text-secondary">Consultez les modules, leçons et contenus sans pouvoir les modifier.</p></div>@if(Model.Count==0){<div class="empty-state">Aucune formation ne vous est actuellement assignée.</div>}else{<div class="row g-4">@foreach(var item in Model){<div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><span class="badge @item.Status.ToBadgeClass()">@item.Status.ToFrenchLabel()</span><h2 class="h5 fw-bold mt-3">@item.Title</h2><p class="text-secondary">@item.ModuleCount module(s)</p><a class="btn btn-outline-success" asp-action="Details" asp-route-id="@item.Id">Consulter le contenu</a></div></div></div>}</div>}</div>

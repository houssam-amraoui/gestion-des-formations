@model TrainingManagement.Application.Pedagogy.TrainerTrainingDetails
@{ViewData["Title"]=Model.Title;}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Mes formations</a></li><li class="breadcrumb-item active">@Model.Title</li></ol></nav><div class="mb-4"><span class="badge text-bg-success">Consultation en lecture seule</span><h1 class="h2 fw-bold mt-2">@Model.Title</h1><span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToFrenchLabel()</span></div>
@if(Model.Modules.Count==0){<div class="empty-state">Cette formation ne contient aucun module.</div>}else{<div class="accordion" id="trainer-outline">@foreach(var module in Model.Modules){<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#trainer-module-@module.Id"><strong>@module.Order. @module.Title</strong><span class="badge @(module.IsPublished?"text-bg-success":"text-bg-warning") ms-3">@(module.IsPublished?"Publié":"Non publié")</span></button></h2><div id="trainer-module-@module.Id" class="accordion-collapse collapse"><div class="accordion-body">@if(module.Lessons.Count==0){<p class="text-secondary">Aucune leçon.</p>}@foreach(var lesson in module.Lessons){<div class="d-flex justify-content-between border-bottom py-3"><span>@lesson.Order. @lesson.Title</span><span><span class="badge @(lesson.IsPublished?"text-bg-success":"text-bg-warning")">@(lesson.IsPublished?"Publiée":"Non publiée")</span> <small class="text-secondary">@lesson.ContentCount bloc(s)</small></span></div>}</div></div></div>}</div>}</div>

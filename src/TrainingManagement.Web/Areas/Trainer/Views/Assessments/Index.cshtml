@model TrainingManagement.Web.ViewModels.Assessments.AssessmentIndexViewModel
@{var c=Model.Collection;ViewData["Title"]="Évaluations";}
<div class="container admin-page"><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@c.TrainingId">@c.TrainingTitle</a></li><li class="breadcrumb-item active">Évaluations de @c.LessonTitle</li></ol></nav><span class="badge text-bg-success">Consultation en lecture seule</span><h1 class="h2 fw-bold mt-2">Évaluations</h1>@if(c.Items.Count==0){<div class="empty-state">Aucune évaluation.</div>}else{<div class="list-group">@foreach(var a in c.Items){<a class="list-group-item list-group-item-action d-flex justify-content-between" asp-action="Details" asp-route-id="@a.Id"><span><strong>@a.Order. @a.Title</strong><br/><small>@a.AssessmentType.ToFrenchLabel() · @a.QuestionCount question(s)</small></span><span>@a.TotalPoints points</span></a>}</div>}</div>

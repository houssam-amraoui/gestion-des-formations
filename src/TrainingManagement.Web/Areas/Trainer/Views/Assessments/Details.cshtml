@model TrainingManagement.Web.ViewModels.Assessments.AssessmentPreviewViewModel
@{var p=Model.Preview;var a=p.Assessment;ViewData["Title"]=a.Title;}
<div class="container py-5"><div class="alert alert-success">Consultation formateur en lecture seule — aucune réponse ne sera enregistrée.</div><h1>@a.Title</h1><p>@a.Description</p><div class="mb-3"><span class="badge text-bg-info">@a.AssessmentType.ToFrenchLabel()</span> <span class="badge text-bg-primary">@a.TotalPoints points</span></div>
@foreach(var q in p.Questions){<section class="card border-0 shadow-sm mb-3"><div class="card-body"><h2 class="h5">@q.Order. @q.Statement <span class="badge text-bg-primary">@q.Points pt</span></h2><span class="badge text-bg-secondary">@q.QuestionType.ToFrenchLabel()</span>@if(q.QuestionType==QuestionType.ShortAnswer){<div class="alert alert-success mt-3"><strong>Réponse attendue :</strong> @q.ExpectedAnswer</div>}else{<ul class="list-group mt-3">@foreach(var o in q.Options){<li class="list-group-item d-flex justify-content-between">@o.Text @if(o.IsCorrect){<span class="badge text-bg-success">Bonne réponse</span>}</li>}</ul>}@if(!string.IsNullOrWhiteSpace(q.Explanation)){<p class="mt-3"><strong>Explication :</strong> @q.Explanation</p>}</div></section>}</div>

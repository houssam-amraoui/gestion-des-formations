{
  "Application": {
    "Name": "Training Management",
    "PublicBaseUrl": ""
  },
  "CertificateStorage": {
    "Provider": "Local",
    "BasePath": "/app/data/certificates"
  },
  "DataProtection": {
    "KeysPath": "/app/data/keys",
    "ApplicationName": "TrainingManagement"
  },
  "Maintenance": {
    "TempPath": "/app/data/temp"
  },
  "SeedAdmin": {
    "Enabled": false
  },
  "AiTrainer": {
    "Enabled": false,
    "Provider": "Anam",
    "LanguageModelProvider": "External",
    "AvatarProvider": "Anam",
    "SpeechToTextProvider": "External",
    "TextToSpeechProvider": "External"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*"
}
